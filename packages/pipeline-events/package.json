      "version": ">=10",
      "onFail": "ignore"
    }
  },
  "main": "lib/index.js",
  "license": "Apache-2.0",
  "homepage": "https://mwashburn160.github.io/pipeline-builder/",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "version": "4.0.18",
  "bugs": {
    "url": "https://github.com/mwashburn160/pipeline-builder/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "jest": {
    "coverageProvider": "v8",
    "testMatch": [
      "<rootDir>/@(src|test)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(src|test)/**/__tests__/**/*.ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "test/tsconfig.json",
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "extensionsToTreatAsEsm": [
      ".ts",
      ".tsx"
    ],
    "moduleNameMapper": {
      "^uuid$": "<rootDir>/../../jest-uuid-stub.js",
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@aws-sdk/client-sqs$": "<rootDir>/test/aws-sdk-stub.js",
      "^@aws-sdk/client-codecommit$": "<rootDir>/test/aws-sdk-stub.js"
    },
    "restoreMocks": true,
    "setupFilesAfterEnv": [
      "<rootDir>/../../jest-env-guard.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/testing/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 78,
        "functions": 95,
        "lines": 95
      }
    }
  },
  "types": "lib/index.d.ts",
  "type": "module",
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"pnpm dlx projen\"."
}
