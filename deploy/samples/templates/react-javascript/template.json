{
  "name": "react-javascript",
  "description": "Golden-path template for a React (Vite, JavaScript) app on GitHub. Builds the bundle with npm and runs a dependency audit plus secret scanning.",
  "category": "frontend",
  "keywords": [
    "react",
    "javascript",
    "frontend",
    "ui"
  ],
  "visibility": "public",
  "inputs": [
    {
      "name": "orgId",
      "label": "Organization ID",
      "description": "Your organization's ID (the UUID, not the display name). Selects the GitHub OAuth token secret at pipeline-builder/<orgId>/github-token.",
      "type": "string",
      "required": true
    }
  ],
  "props": {
    "global": {
      "aws:cdk:pipelines:codepipeline:selfmutation": true,
      "aws:cdk:pipelines:codepipeline:dockerenabledforselfmutation": true,
      "aws:cdk:pipelines:codepipeline:publishassetsinparallel": true,
      "aws:cdk:pipelines:codepipeline:crossaccountkeys": true,
      "aws:cdk:pipelines:codepipeline:enablekeyrotation": true,
      "aws:cdk:pipelines:codepipeline:reusecrossregionsupportstacks": true,
      "aws:cdk:pipelines:codepipeline:usechangesets": false
    },
    "synth": {
      "source": {
        "type": "github",
        "options": {
          "repo": "sitek94/vite-deploy-demo",
          "branch": "main",
          "trigger": "NONE",
          "token": "secretsmanager:pipeline-builder/{{ pipeline.vars.orgId }}/github-token"
        }
      },
      "plugin": {
        "name": "BuildSynth",
        "filter": {
          "name": "cdk-synth",
          "version": "1.0.0",
          "visibility": "public",
          "isActive": true,
          "isDefault": true
        }
      }
    },
    "stages": [
      {
        "stageName": "Build",
        "alias": "BuildAndPackage",
        "steps": [
          {
            "plugin": {
              "name": "nodejs-bundle",
              "filter": {
                "name": "nodejs-bundle",
                "version": "1.0.0",
                "visibility": "public",
                "isActive": true,
                "isDefault": true
              },
              "metadata": {
                "BUILD_SCRIPT": "build"
              }
            },
            "position": "pre",
            "timeout": 20
          }
        ]
      },
      {
        "stageName": "Security",
        "alias": "SecurityScan",
        "steps": [
          {
            "plugin": {
              "name": "npm-audit",
              "filter": {
                "name": "npm-audit",
                "version": "1.0.0",
                "visibility": "public",
                "isActive": true,
                "isDefault": true
              },
              "metadata": {
                "AUDIT_LEVEL": "high"
              }
            },
            "position": "pre",
            "failureBehavior": "warn"
          },
          {
            "plugin": {
              "name": "git-secrets",
              "filter": {
                "name": "git-secrets",
                "version": "1.0.0",
                "visibility": "public",
                "isActive": true,
                "isDefault": true
              }
            },
            "position": "post",
            "failureBehavior": "warn"
          }
        ]
      }
    ]
  }
}
