   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "A volume of many small files hits 100% of inodes with plenty of free bytes, and every byte-based panel stays green."
  },
  {
   "id": 17,
   "type": "row",
   "title": "Network — DNS, mesh, and service-to-service",
