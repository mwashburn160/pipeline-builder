  {
   "id": 16,
   "type": "timeseries",
   "title": "PersistentVolume inodes free",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 44,
    "w": 12,
