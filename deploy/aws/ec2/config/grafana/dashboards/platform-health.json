  {
   "id": 18,
   "type": "timeseries",
   "title": "DNS query rate and SERVFAIL",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 53,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(coredns_dns_requests_total[5m]))",
     "legendFormat": "queries"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(coredns_dns_responses_total{rcode=\"SERVFAIL\"}[5m]))",
     "legendFormat": "SERVFAIL"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "Queries falling to zero while CoreDNS is up is the documented outage: the resolver is healthy and nothing can route to it."
  },
  {
   "id": 19,
   "type": "timeseries",
   "title": "Mesh authorization denials (waypoint 403s)",
   "datasource": {
