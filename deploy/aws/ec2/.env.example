# ============================================================================
# Pipeline Builder - AWS EC2 Environment Configuration
# ============================================================================
# GENERATED from deploy/shared/env/env.example.in by scripts/gen-env-examples.mjs.
# Edit the template and regenerate; CI fails on a hand-edited copy.
#
# Copy to .env and fill in values. The CHANGE_ME secrets are generated for you:
# bootstrap.sh fills them on first boot.
# IMPORTANT: never commit .env to version control.
# ============================================================================

# ============================================================================
# Persistent Storage
# ============================================================================
# EBS data volume mounts at $PIPELINE_ROOT. Inside:
#   $PIPELINE_ROOT/pipeline-builder/  -> git checkout (persists on EBS)
#   $PIPELINE_ROOT/pipeline-data/     -> runtime state (db, registry, plugins)
#
# If EBS is unavailable at boot, UserData falls back to a root-volume dir at
# the same path and writes $PIPELINE_ROOT/.ephemeral as a sentinel. Services
# still start; nothing persists across instance replacement. SSH in and check
# `[ -f /opt/pipeline/.ephemeral ]` to detect degraded state.
PIPELINE_ROOT=/opt/pipeline

# ============================================================================
# EC2 / Domain Configuration
# ============================================================================

# Domain name for this deployment (set by bootstrap.sh from CloudFormation).
# REQUIRED — TLS is terminated at the ALB with an ACM cert issued for this name.
DOMAIN=YOUR_DOMAIN_HERE

# Deployment posture — flips the ALB scheme only; the instance is ALWAYS private
# (no public IP) and TLS is always terminated at the ALB with an ACM cert.
#   private = internal-scheme ALB in private subnets; CodeBuild is VPC-attached
#             and reaches the ALB via a Route53 PRIVATE zone alias. (default)
#   public  = internet-facing ALB; CodeBuild reaches the ALB over the internet.
# init-platform.sh preflights the private-mode prerequisites below.
DEPLOY_MODE=private

# Private-mode ONLY — VPC config for the CodeBuild projects the pipeline
# service synthesizes. Leave BLANK in public mode (CodeBuild then runs in the
# AWS-managed network). In private mode these are REQUIRED — setup.sh provisions
# the VPC interface endpoints + the Route53 PRIVATE zone alias → the internal
# ALB in private mode; you still supply egress (NAT or internal mirrors)
# for build deps. Set these to the stack's VpcId / SubnetIds / AlbSecurityGroupId.
PIPELINE_VPC_ID=
PIPELINE_SUBNET_IDS=
PIPELINE_SECURITY_GROUP_IDS=

# GHCR credentials. The ghcr.io/mwashburn160/* images are PUBLIC (anonymous
# pulls work), but GitHub rate-limits anonymous pulls at 60 req/hr per IP
# which trips mid-deploy when EC2 fans out 9 service-image pulls. Providing
# your own PAT raises the ceiling to 5,000 req/hr.
#
# Use YOUR OWN GitHub Personal Access Token + username  never copy a value
# from documentation, an example, or another user's deploy.
# - Generate at https://github.com/settings/tokens (Classic, scope: read:packages)
# or https://github.com/settings/personal-access-tokens (Fine-grained,
# account permission: Packages: Read).
# - Leave both blank for anonymous pulls (slower, occasional 429s).
GHCR_TOKEN=
# ghcr.io validates only the token for PAT auth; the username is the fixed image
# owner (bootstrap.sh rewrites this line, which must match the literal below).
GHCR_USER=mwashburn160

# ============================================================================
# Platform Configuration
# ============================================================================

# Platform URL - Used by services to reference the API gateway
# Used by CLI when PLATFORM_BASE_URL environment variable is not set
PLATFORM_BASE_URL=https://YOUR_DOMAIN_HERE

# Frontend URL - Used for email links, OAuth redirects, etc.
PLATFORM_FRONTEND_URL=https://YOUR_DOMAIN_HERE

# Frontend server-side relay target for client error reports (runtime); empty = reporting off.
ERROR_REPORT_URL=
DEPLOY_TARGET=aws-ec2

# Node runtime mode. MUST be `production` in every deploy target: a long list
# of security guards keys off it and SILENTLY degrades when it is unset (which
# is the default — the images set no NODE_ENV). With it unset, platform wraps AI
# provider keys under an all-zeros encryption key and resolves cookie `secure`
# to false; api-server also skips the tightened production CSP. (Neither signing
# key has a dev fallback: platform refuses to start without its user-token key,
# and every service refuses to start without its own service key, in every mode.)
NODE_ENV=production

# Postgres TLS. Explicitly OFF because this target runs Postgres without a
# server certificate. This MUST stay set: getSslConfig defaults SSL *on* when
# NODE_ENV=production, so removing this line takes the database connection down
# for every service. Set to `true` only against a Postgres that actually serves
# TLS (e.g. RDS), and pair it with DB_SSL_REJECT_UNAUTHORIZED=true once the CA
# bundle is wired.
DB_SSL=false

# Service port (used by platform, quota, pipeline-core)
PORT=3000

# Number of reverse-proxy hops in front of every Express service, so req.ip
# (rate-limit buckets, audit source IP) is the real client, not a proxy.
# 1: nginx is the only hop a service sees. nginx resolves the client itself
# (real_ip, trusting X-Forwarded-For ONLY when the TCP peer is inside the load
# balancer CIDRs setup derives — PB_TRUSTED_PROXY_CIDRS) and OVERWRITES
# X-Forwarded-For with that single address, so a client-supplied entry can
# never be picked. The Istio ambient ztunnel is L4 and adds no hop.
TRUST_PROXY=1

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (error | warn | info | debug)
LOG_LEVEL=info

# Log format: 'json' for structured JSON (used by Loki), 'text' for human-readable
LOG_FORMAT=json

# Service name used in log output
SERVICE_NAME=api

# ============================================================================
# CORS Configuration
# ============================================================================

# Allow credentials in CORS requests (true | false)
CORS_CREDENTIALS=true

# Allowed CORS origins (comma-separated, leave empty for default)
# Example: https://pipeline.example.com
CORS_ORIGIN=

# ============================================================================
# JWT Configuration (REQUIRED)
# ============================================================================

# INTERNAL SERVICE-TO-SERVICE tokens. There is NO shared secret: each
# service signs `service:<name>` tokens with its OWN ES256 key and verifies its
# peers against the shared PUBLIC bundle, so a `kid` names the signer and one
# service can never speak for another. Tokens that speak for a PERSON are ES256
# signed by platform alone (see TOKEN_SIGNING_* below).
#
# Both files are generated by `deploy/bin/service-signing-keys.sh` and mounted
# read-only; a service refuses to start without them. The private key is the
# ONLY per-service value — the bundle is public and identical everywhere.
# Rotation is two-phase and by `kid`: docs/runbooks/secret-rotation.md.
SERVICE_SIGNING_KEY_FILE=/etc/pipeline-builder/service-keys/service.key
SERVICE_KEY_BUNDLE_FILE=/etc/pipeline-builder/service-key-bundle/bundle.json

# JWT Token expiration (in seconds)
# 900 = 15 minutes, 3600 = 1 hour, 86400 = 24 hours
JWT_EXPIRES_IN=7200

# bcrypt password-hash cost. Higher = more secure but slower (10-12 recommended).
# (Renamed from JWT_SALT_ROUNDS — that name was misleading; this controls bcrypt
# password hashing, not JWT signing. The old name is no longer read.)
BCRYPT_SALT_ROUNDS=12

# Per-tier access-token TTL overrides (seconds). Compliance-driven
# enterprise tiers (SOC2 / FedRAMP) typically want SHORTER TTLs to narrow
# the stolen-token blast window. Recommended for production EC2 deploys.
# JWT_EXPIRES_IN_DEVELOPER=7200
# JWT_EXPIRES_IN_PRO=3600
# JWT_EXPIRES_IN_TEAM=1800
# JWT_EXPIRES_IN_ENTERPRISE=1800

# Refresh Token expiration (in seconds)
# 2592000 = 30 days. Refresh tokens have no secret of their own — they are user
# tokens, signed with the same ES256 key (and rotated by the same kid) as
# everything else a person holds.
REFRESH_TOKEN_EXPIRES_IN=2592000

# ----------------------------------------------------------------------------
# User-token signing (ES256) — platform ONLY
# ----------------------------------------------------------------------------
# Platform signs every token that speaks for a person (access, refresh, step-up,
# exchanged access keys) with an EC P-256 key and publishes the public half at
# /.well-known/jwks.json. Nothing else in the fleet can mint one.
#
# Ships as `local` (a PEM generated by deploy/bin/token-signing-keys.sh and
# mounted as the `token-signing-key` Kubernetes Secret) so a fresh deploy comes
# up without any manual AWS step.
#
# RECOMMENDED FOR PRODUCTION — switch to KMS, where the private key never leaves
# AWS and platform holds only permission to use it:
#
#   aws kms create-key --key-spec ECC_NIST_P256 --key-usage SIGN_VERIFY
#   aws kms create-alias --alias-name alias/pipeline-builder-token-signing \
#     --target-key-id <key-id>
#   # grant the node/instance role kms:Sign + kms:GetPublicKey on that key
#
# then set TOKEN_SIGNING_MODE=kms and TOKEN_SIGNING_KMS_KEY_ID below. Name the
# key BY ALIAS, never by ARN — an alias carries no AWS account id.
# Cutover + rotation: docs/runbooks/secret-rotation.md
TOKEN_SIGNING_MODE=local
TOKEN_SIGNING_KEY_FILE=/etc/pipeline-builder/keys/token-signing.key
# Rotation overlap ONLY (normally empty): the RETIRING key. It is PUBLISHED in
# the JWKS so tokens it signed keep verifying, but never signs anything new.
# `deploy/bin/token-signing-keys.sh --rotate` produces it; clear this once every
# token signed with the old kid has expired.
TOKEN_SIGNING_KEY_PREVIOUS_FILE=
# KMS mode (TOKEN_SIGNING_MODE=kms) reads these two instead of the files above.
# TOKEN_SIGNING_KMS_KEY_ID=alias/pipeline-builder-token-signing
# TOKEN_SIGNING_KMS_KEY_PREVIOUS_ID=

# ----------------------------------------------------------------------------
# Plugin-image signing (cosign, EC P-256) — image-registry ONLY
# ----------------------------------------------------------------------------
# Every plugin image the plugin service pushes is signed (key-based, no
# transparency log) and gets a signed SPDX SBOM attestation; synth pins
# CodeBuild to the verified digest. image-registry holds the PRIVATE key and
# signs on plugin's behalf; plugin holds only the PUBLIC key, because it shares
# a network namespace with the buildkitd that runs tenant Dockerfile steps.
#
# Ships as `local` (a PEM generated by deploy/bin/plugin-signing-keys.sh and
# mounted into image-registry as the `plugin-signing-key` Secret; the public
# half goes to plugin as `plugin-signing-public-key`).
#
# RECOMMENDED FOR PRODUCTION — switch to KMS, where the private key never leaves
# AWS and image-registry holds only permission to use it:
#
#   aws kms create-key --key-spec ECC_NIST_P256 --key-usage SIGN_VERIFY
#   aws kms create-alias --alias-name alias/pipeline-builder-plugin-signing \
#     --target-key-id <key-id>
#   # grant the INSTANCE ROLE kms:Sign + kms:GetPublicKey on that key
#
# ec2 has no per-pod identity: image-registry's cosign reads the instance role
# from IMDS, so the grant goes on the instance role (plugin's egress excepts
# link-local, so plugin still cannot use it). image-registry also needs egress
# to IMDS (169.254.169.254:80) and to the KMS endpoint — in the private-VPC
# template that is the KMS interface VPC endpoint on 10.x. Both are opened by
# allow-image-registry-kms-egress in k8s/networkpolicy.yaml.
#
# then set PLUGIN_SIGNING_MODE=kms and PLUGIN_SIGNING_KMS_KEY_ID below. Name the
# key BY ALIAS, never by ARN — an alias carries no AWS account id. Setup exports
# the public key from KMS for plugin (the operator needs kms:GetPublicKey).
# Switching signer (or rotating) invalidates every existing signature — every
# plugin image must be re-signed. docs/runbooks/secret-rotation.md
PLUGIN_SIGNING_MODE=local
# PLUGIN_SIGNING_KMS_KEY_ID=alias/pipeline-builder-plugin-signing

# ============================================================================
# Plugin Ecosystem — flags and kill switches (docs/runbooks/ecosystem-moderation.md#kill-switches)
# ============================================================================
# Public, searchable plugin directory (/plugins, /api/public/plugins*). Needs
# ECOSYSTEM_PUBLIC_READER_PASSWORD; off → both return 404.
PUBLIC_DIRECTORY_ENABLED=true
# Tenant orgs may SUBMIT publish requests (every listing/version is still approved
# by the system org's Ecosystem Managers). Off by default for self-hosted
# instances; the hosted hub turns it on. Off → existing listings still resolve.
PLUGIN_PUBLISHING_ENABLED=false
# Ratings and reviews (off → reviews are read-only).
PLUGIN_REVIEWS_ENABLED=true
# Not-logged-in plugin submissions (quarantine → isolated build → moderation).
# Requires outbound email (magic-link verification); stays unavailable without it.
ANONYMOUS_SUBMISSIONS_ENABLED=false
# Anonymous submissions (only read while the flag
# above is on). The two secrets are generated by bin/gen-env-secrets.sh; the
# plugin service refuses to serve submissions without them (fail closed).
# HMAC key for the self-hosted proof-of-work challenges.
SUBMISSION_POW_SECRET=CHANGE_ME
# Leading zero BITS a PoW solution needs (20 ≈ 1M hashes, ~1s in a browser worker).
SUBMISSION_POW_DIFFICULTY=20
# HMAC key the submitter email is hashed under (rate limits, update ownership).
SUBMISSION_EMAIL_HASH_SECRET=CHANGE_ME
# Hard cap on one quarantine build (the isolated buildkitd), in seconds.
SUBMISSION_BUILD_TIMEOUT_SECONDS=900
# Largest accepted submission zip (bytes) — nginx caps the POST body at 50m to match.
SUBMISSION_MAX_ZIP_BYTES=52428800
# Object-storage bucket the submission zips wait in (30-day lifecycle expiry;
# created by minio-init with the plugin service's bucket-scoped credentials).
PLUGIN_QUARANTINE_BUCKET=plugin-quarantine
# The ISOLATED buildkitd quarantine builds run on — never the tenant one (no
# fallback: the plugin service fails closed without it).
PLUGIN_QUARANTINE_BUILDKIT_ADDR=tcp://plugin-quarantine-builder:1234
# Seeded rule that auto-approves routine gate-green patch/minor updates of
# existing Official listings from the catalog loader. Off → every
# Official update waits for two-person approval.
OFFICIAL_AUTO_APPROVAL_ENABLED=true

# ============================================================================
# Security Configuration
# ============================================================================

# pgBouncer connection pooler, enabled by default — every service connects
# via DB_HOST=pgbouncer / DB_PORT=6432 (set below). The pgbouncer manifest is
# registered in `k8s/kustomization.yaml`. Per-tier logical databases
# (pipeline_builder_<tier>) enforce separate pool budgets.

# Behavior when withTenantTx is called outside any tenant scope (e.g. from
# a background worker that forgot to wrap itself in runWithTenantContext).
#   strict — throw at the call site. The services connect as the DB_USER
#            application role, which is NOT a superuser and does NOT bypass
#            row-level security, so a query without tenant context would
#            otherwise silently see zero rows / have its writes rejected by
#            the RLS policies. Failing loudly names the broken call site.
#   warn   — log a stack-traced warning and run with empty RLS GUCs.
#   silent — no log, no throw. Test scripts only.
RLS_CONTEXT_MODE=strict

# Bootstrap super-admins on platform startup. Comma-separated user emails;
# accounts matching these emails are auto-promoted to isSuperAdmin=true at
# boot. Idempotent. Required for fresh installs.
# Keep in sync with PLATFORM_IDENTIFIER: init-platform.sh registers the admin into
# the reserved "system" org, which ONLY an email listed here may create — a custom
# PLATFORM_IDENTIFIER not listed here breaks fresh-install super-admin bootstrap.
BOOTSTRAP_SUPERADMIN_EMAILS=admin@internal
# How long after install (ms) a password-only bootstrap admin may still mint the
# `setup` service account + key without enrolling MFA (default: 86400000 = 24h).
# Raise only for an install that legitimately takes longer than a day.
# BOOTSTRAP_SETUP_WINDOW_MS=86400000

# Opt into per-org KMS key wrapping for AI provider keys + IdP secrets.
# When 'true', secret-encryption resolves each org's KMS CMK from
# Organization.kmsConfig; orgs without an entry fall through to the shared
# SECRET_ENCRYPTION_KEY master. Recommended for compliance-driven deploys.
# SECRET_ENCRYPTION_PER_ORG_KMS=false

# Per-org HTTP request metric sampling (range [0.0, 1.0]). Defaults to 0 (OFF).
# `org_id` is an unbounded, tenant-identifying metric label and prom-client
# counters never expire, so at the old default of 1.0 every service accumulated
# a series per (org x route x status) for the process lifetime — and /metrics is
# not auth-gated, so it enumerated every tenant id with its request volume.
# Turn it on deliberately, ideally well under 1.0 and with METRICS_SCRAPE_TOKEN set.
# HTTP_METRICS_ORG_SAMPLE_RATE=0.05

# Per-org SSE connection ceiling. Default 50.
# SSE_MAX_CLIENTS_PER_ORG=50

# Minimum password length (code uses PASSWORD_MIN_LENGTH, default: 8)
PASSWORD_MIN_LENGTH=12

# Breached-password check at registration, password change and admin reset:
# `hibp` (the code default, set explicitly here) queries the Have I Been Pwned
# range API with only the first 5 hex chars of the password's SHA-1
# (k-anonymity — the password itself never leaves the process).
# FAIL-OPEN: an unreachable/slow API lets the password through, metered as
# platform_password_breach_checks_total{outcome="unavailable"} and alerted on by
# PasswordBreachCheckUnavailable.
#
# OUTBOUND INTERNET CALL. This is one of only two settings that make platform
# talk to a third party on the auth path (the other is FIDO_MDS_URL below), and
# it is spelled out rather than left to the code default so the traffic is
# visible in the deploy, not a surprise in a packet capture.
#   AIR-GAPPED / no-egress install:  PASSWORD_BREACH_CHECK=off
#   (the length/complexity rules, the per-account login throttle and the per-IP
#   auth limiter all keep working — this is defence in depth, not the only line)
# Point PASSWORD_BREACH_CHECK_URL at an internal mirror of the range API to keep
# the check without the egress. The platform network policy must allow 443 to
# the host named here.
PASSWORD_BREACH_CHECK=hibp
PASSWORD_BREACH_CHECK_URL=https://api.pwnedpasswords.com/range/
PASSWORD_BREACH_CHECK_TIMEOUT_MS=2000

# Per-ACCOUNT password sign-in throttle (failed attempts only, keyed on a hash
# of the identifier). The per-IP limit on /auth/* is AUTH_LIMITER_*.
# LOGIN_ACCOUNT_LIMITER_MAX=10
# LOGIN_ACCOUNT_LIMITER_WINDOWMS=900000

# ============================================================================
# OAuth / social login (optional — a provider is enabled only when its CLIENT_ID is set)
# ============================================================================
# Public "Sign in with X" buttons on the login/register pages. Each provider is
# fail-soft: it stays hidden until its OAUTH_<PROVIDER>_CLIENT_ID is set, so leave
# a pair empty to disable that provider. Per-provider redirect/callback URI:
#   ${OAUTH_CALLBACK_BASE_URL}/auth/callback/<provider>
#
# NOTE: per-org ENTERPRISE SSO (Cognito / Okta / Entra via OIDC) is NOT configured
# here — each organization sets it up self-service in the app dashboard (OrgIdpConfig),
# not through these env vars.

# Google — https://console.cloud.google.com/apis/credentials
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub — https://github.com/settings/developers (OAuth Apps)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Facebook — https://developers.facebook.com/apps (Facebook Login)
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=

# Microsoft (Entra ID / Azure AD) — https://entra.microsoft.com (App registrations)
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
# Entra tenant: 'common' (any account), 'organizations', 'consumers', or a tenant ID
OAUTH_MICROSOFT_TENANT=common

# GitLab — https://gitlab.com/-/profile/applications (self-hosted: Admin → Applications)
OAUTH_GITLAB_CLIENT_ID=
OAUTH_GITLAB_CLIENT_SECRET=
# GitLab base URL — point at your instance for self-hosted GitLab
OAUTH_GITLAB_BASE_URL=https://gitlab.com

# LinkedIn — https://www.linkedin.com/developers/apps (Sign In with LinkedIn using OpenID Connect)
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=

# OAuth callback base URL (defaults to PLATFORM_FRONTEND_URL if not set)
# Only override if your frontend URL differs from the OAuth redirect origin
OAUTH_CALLBACK_BASE_URL=${PLATFORM_FRONTEND_URL}

# OAuth CSRF state token TTL in milliseconds (default: 600000 = 10 minutes)
# OAUTH_STATE_TTL_MS=600000

# ============================================================================
# Passkeys (WebAuthn)
# ============================================================================
# The relying party is DERIVED from PLATFORM_FRONTEND_URL and is never read from
# the request: RP ID = its exact hostname (YOUR_DOMAIN_HERE), origin = its scheme, host and
# port (https://YOUR_DOMAIN_HERE).
#
# WARNING: the RP ID is PERMANENT. Every passkey is bound to the value in force
# when it was registered, so changing it (or changing PLATFORM_FRONTEND_URL's
# hostname) orphans every credential already enrolled — there is no migration and
# affected users must enrol again. The platform refuses to boot if the RP ID is an
# IP address, if an origin is not the RP ID or a subdomain of it, or if an origin
# is plain http (http://localhost excepted).
#
# Set these ONLY when the origin people browse to differs from
# PLATFORM_FRONTEND_URL (a CDN alias, a split app/api hostname).
# WEBAUTHN_RP_ID=YOUR_DOMAIN_HERE
# WEBAUTHN_ORIGINS=https://YOUR_DOMAIN_HERE
# WEBAUTHN_RP_NAME=Pipeline Builder
# How long a passkey ceremony may take, in ms (default: 120000 = 2 minutes)
# WEBAUTHN_CHALLENGE_TTL_MS=120000
# Cap on the in-memory ceremony fallback, used only when no Redis is configured
# WEBAUTHN_MAX_PENDING_CEREMONIES=1000
# FIDO Metadata Service (MDS3) — used ONLY when an org sets an
# approved-authenticator (AAGUID) allowlist: its passkey registrations request
# DIRECT attestation and are REFUSED while no metadata is loaded. The blob's
# signature chain is verified against the FIDO root whatever the source, then
# cached in memory for FIDO_MDS_REFRESH_MS.
#
# OUTBOUND INTERNET CALL, spelled out rather than left to the code default so
# the egress is visible in the deploy. Source order: FIDO_MDS_BLOB_PATH (a blob
# JWT already on disk) wins; otherwise the blob is fetched from FIDO_MDS_URL.
#   AIR-GAPPED / no-egress install, orgs that use AAGUID allowlists:
#     download https://mds.fidoalliance.org/ out of band, mount the file into
#     platform, set FIDO_MDS_BLOB_PATH to it and FIDO_MDS_URL=off. The blob
#     expires — refresh it on the schedule in docs/runbooks/secret-rotation.md.
#   AIR-GAPPED, no org uses AAGUID allowlists:
#     FIDO_MDS_URL=off and leave FIDO_MDS_BLOB_PATH empty. Passkeys keep working
#     everywhere; only an allowlisted-authenticator policy would be refused.
# The platform network policy must allow 443 to the host named here.
FIDO_MDS_BLOB_PATH=
FIDO_MDS_URL=https://mds.fidoalliance.org/
FIDO_MDS_FETCH_TIMEOUT_MS=10000
FIDO_MDS_REFRESH_MS=86400000

# ============================================================================
# Quota Tier Defaults (Quota Service)
# ============================================================================
# Tier presets are defined in code (platform config + quota-helpers).
# These env vars set the quota service's *fallback* defaults for orgs
# that don't yet have a tier assigned.
#
# Tier presets (hardcoded in platform/src/config and quota-helpers):
# developer: plugins=25, pipelines=5, apiCalls=25000, reset=3days
# pro: plugins=50, pipelines=10, apiCalls=500000, reset=3days
# team: plugins=100, pipelines=200, apiCalls=-1, reset=30days
# enterprise: plugins=250, pipelines=200, apiCalls=-1, reset=30days
#
# NOTE: the QUOTA_DEFAULT_* below are intentionally-generous LOCAL fallback
# defaults for not-yet-provisioned orgs — they do NOT equal any single tier
# preset above. Leave them UNSET to fall back to the code's developer-tier
# preset instead (quota/src/config.ts uses DEV.* when the env is absent).
QUOTA_DEFAULT_PLUGINS=100
QUOTA_DEFAULT_PIPELINES=10
QUOTA_DEFAULT_API_CALLS=-1
QUOTA_RESET_DAYS=3

# ----------------------------------------------------------------------------
# Quota TIER overrides (optional). The tier presets in
# packages/api-core/src/types/quota-tiers.ts are the CODE DEFAULTS; set any var
# below to override. -1 = unlimited. On k8s these reach the quota service via
# the app-env ConfigMap (built from this file); no manifest change needed.
#
# Default tier assigned to NEW orgs (developer | pro | team | enterprise):
# DEFAULT_QUOTA_TIER=developer
#
# Per-tier limits — pattern: QUOTA_TIER_<DEVELOPER|PRO|TEAM|ENTERPRISE>_<LIMIT>
#   LIMIT ∈ PLUGINS, PIPELINES, API_CALLS, AI_CALLS, STORAGE_BYTES,
#           DASHBOARDS, ALERT_RULES, ALERT_DESTINATIONS, IDP_CONFIGS, LISTINGS, SEATS
# Examples (values shown are the current code defaults — uncomment to override):
# QUOTA_TIER_DEVELOPER_PLUGINS=50
# QUOTA_TIER_DEVELOPER_PIPELINES=5
# QUOTA_TIER_DEVELOPER_AI_CALLS=50
# QUOTA_TIER_DEVELOPER_STORAGE_BYTES=2147483648
# QUOTA_TIER_DEVELOPER_SEATS=1
# QUOTA_TIER_PRO_PLUGINS=500
# QUOTA_TIER_PRO_PIPELINES=50
# QUOTA_TIER_PRO_AI_CALLS=2500
# QUOTA_TIER_PRO_SEATS=3
# QUOTA_TIER_TEAM_PLUGINS=2000
# QUOTA_TIER_TEAM_PIPELINES=200
# QUOTA_TIER_TEAM_AI_CALLS=10000
# QUOTA_TIER_TEAM_SEATS=10
# QUOTA_TIER_ENTERPRISE_PLUGINS=5000
# QUOTA_TIER_ENTERPRISE_SEATS=-1
# Tier display labels (optional):
# QUOTA_TIER_DEVELOPER_LABEL=Developer
# QUOTA_TIER_PRO_LABEL=Pro
# QUOTA_TIER_TEAM_LABEL=Team
# QUOTA_TIER_ENTERPRISE_LABEL=Enterprise

# ============================================================================
# Quota Service Configuration
# ============================================================================
# Internal service discovery for quota enforcement
# Used by: plugin, pipeline services

# Quota service hostname (K8s service name)
QUOTA_SERVICE_HOST=quota

# Quota service port
QUOTA_SERVICE_PORT=3000


# Platform service — billing pushes seat limits + entitlements and reads pooled
# seat usage here (two-target entitlement fan-out + over-cap gate).
PLATFORM_SERVICE_HOST=platform
PLATFORM_SERVICE_PORT=3000

# ============================================================================
# Rate Limiting Configuration
# ============================================================================


# ============================================================================
# Global Rate Limiting
# ============================================================================
# Applied to all API requests (independent of quota middleware)

# Maximum requests per window
LIMITER_MAX=2000

# Rate limit window in milliseconds (900000 = 15 minutes)
LIMITER_WINDOWMS=900000

# Per-tier rate-limit multipliers (platform). The effective per-org request
# budget is LIMITER_MAX × the org tier's multiplier. Defaults shown.
# LIMITER_MULT_DEVELOPER=1
# LIMITER_MULT_PRO=10
# LIMITER_MULT_TEAM=25
# LIMITER_MULT_ENTERPRISE=50

# ============================================================================
# Email Configuration
# ============================================================================
# For SES, prefer the deploy flag: `setup.sh --email` provisions the SES
# identity + DKIM + the instance-role ses:SendEmail grant and sets these values
# automatically (EMAIL_ENABLED=true, EMAIL_PROVIDER=ses, EMAIL_FROM=noreply@<domain>,
# SES_REGION=<deploy region>). The keys below are the manual/SMTP fallback.

# Email sending via SES — provisioned by default (setup.sh --no-email to disable)
EMAIL_ENABLED=true

# Sender information (setup.sh --email defaults EMAIL_FROM to noreply@<domain>)
EMAIL_FROM=noreply@YOUR_DOMAIN_HERE
EMAIL_FROM_NAME=pipeline-builder

# Email provider (smtp | ses) — setup.sh --email sets this to ses
EMAIL_PROVIDER=smtp

# SMTP Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# AWS SES Configuration (used when EMAIL_PROVIDER=ses).
# SES_REGION is pinned to the actual deploy region by bootstrap.sh.
# Leave the access keys BLANK to sign with the EC2 instance role (recommended —
# the deploy grants it ses:SendEmail). Only set them for static-credential SES.
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# SES configuration set — every send routes through it so bounces/complaints
# publish to the SNS topic. Set by bootstrap.sh to pipeline-builder-email when
# setup.sh --email is used; leave blank otherwise.
SES_CONFIGURATION_SET=
AWS_REGION=us-east-1

# --- Amazon Bedrock as an AI provider (optional) ----------------------------
# Bedrock authenticates with the RUNTIME's IAM role, not an API key, so it is
# advertised only when the provider chain has something to resolve: static keys,
# EKS Pod Identity / ECS task role, IRSA, or an AWS_PROFILE.
#
# AWS_REGION alone is NOT enough — every target sets it for pipeline synthesis,
# including local ones with no AWS identity at all. Advertising Bedrock off the
# region made it the only AI provider on a local install, so the Ask assistant
# defaulted to it and every question failed with "Could not load credentials
# from any providers".
#
# The EC2 instance profile is the one credential source with no environment
# marker (it comes from IMDS at call time), so set this to opt in there. Note
# the role still needs bedrock:InvokeModel* — no deploy target grants it today.
# BEDROCK_ENABLED=true

# ============================================================================
# Invitation Configuration
# ============================================================================

# Invitation expiration (in days)
INVITATION_EXPIRATION_DAYS=7

# Maximum pending invitations per organization
INVITATION_MAX_PENDING_PER_ORG=50

# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================

# Bootstrap SUPERUSER. Used ONLY by the postgres container (initdb +
# postgres-init.sql), the postgres exporter and backup/restore. Never give it
# to a service: superusers bypass row-level security, so tenant isolation
# would silently stop being enforced.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pipeline_builder

# Application role every service connects as (through pgbouncer).
# postgres-init.sql creates it on first init as NOSUPERUSER NOBYPASSRLS with
# DML-only grants, reading these two values from the postgres container's
# environment. It must differ from POSTGRES_USER (init refuses otherwise), and
# its password is generated separately from POSTGRES_PASSWORD.
# The name is also referenced by pgbouncer.ini (`stats_users`) — keep in sync.
# Changing either value on an EXISTING database volume does nothing (init only
# runs on an empty data directory); alter the role by hand or re-init.
DB_HOST=pgbouncer
DB_PORT=6432
DATABASE=pipeline_builder
DB_USER=pipeline_app
DB_PASSWORD=CHANGE_ME
# Anonymous public plugin directory: the view-only
# Postgres login `ecosystem_public_reader` (SELECT on public_listings and
# public_listed_versions, nothing else). postgres-init.sql creates it from this
# password, pgbouncer adds it to its userlist, and the plugin service connects
# through pgbouncer to the `pipeline_builder_public` pool as that role — never
# directly to Postgres, and never with DB_PASSWORD. Generated by
# gen-env-secrets.sh; leaving it empty skips the role and disables the directory.
ECOSYSTEM_PUBLIC_READER_PASSWORD=CHANGE_ME
PUBLIC_DIRECTORY_DB_NAME=pipeline_builder_public

# Drizzle ORM Configuration
DRIZZLE_MAX_POOL_SIZE=20
DRIZZLE_IDLE_TIMEOUT_MILLIS=30000
# Connection timeout: pipeline-data defaults 10000, pipeline-core defaults 5000
DRIZZLE_CONNECTION_TIMEOUT_MILLIS=30000

# ============================================================================
# MongoDB Configuration
# ============================================================================

# MongoDB Admin Credentials
# Used by: platform, quota services
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_INITDB_DATABASE=platform

# MongoDB Connection URI (Replica Set)
# Format: mongodb://username:password@host:port/database?options
# Used by: platform, quota services
MONGODB_URI='mongodb://mongo:CHANGE_ME@mongodb:27017/platform?replicaSet=rs0&authSource=admin'

# ============================================================================
# Mongo Express (Infrastructure  MongoDB Admin UI)
# ============================================================================

# Mongo Express Configuration
# Access at: https://YOUR_DOMAIN_HERE/mongo-express/
ME_CONFIG_SITE_BASEURL=/mongo-express/
ME_CONFIG_MONGODB_URL='mongodb://mongo:CHANGE_ME@mongodb:27017/platform?replicaSet=rs0&authSource=admin'
ME_CONFIG_MONGODB_ENABLE_ADMIN=true

# Mongo Express Web Authentication
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=CHANGE_ME

# Serve the admin consoles (/pgadmin/ /mongo-express/ /grafana/ /kiali/) through
# the public gateway. OFF by default — the routes 404. When true, each request
# is gated at nginx by an auth_request to platform (a platform administrator's
# live AAL2 session, from the `pb_admin_console` cookie). Prefer
# `kubectl port-forward` for occasional use.
ADMIN_UIS_ENABLED=false

# ============================================================================
# PgAdmin (Infrastructure  PostgreSQL Admin UI)
# ============================================================================

# PgAdmin Configuration
# Access at: https://YOUR_DOMAIN_HERE/pgadmin/
PGADMIN_DEFAULT_EMAIL=admin@pipeline.dev
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# ============================================================================
# Docker Registry Configuration
# ============================================================================

# Docker Registry for Plugin Images
# Used by: plugin service
IMAGE_REGISTRY_HOST=registry
IMAGE_REGISTRY_PORT=5000
IMAGE_REGISTRY_USER=admin
IMAGE_REGISTRY_TOKEN=CHANGE_ME

# Out-of-cluster pull host/port for the synthesized CodeBuild image URI.
# In-cluster services keep using IMAGE_REGISTRY_HOST (registry:5000); AWS
# CodeBuild can't resolve that ClusterIP, so it pulls plugin images via the
# public gateway instead. ${DOMAIN} is expanded by startup.sh's envsubst.
# Leave IMAGE_REGISTRY_PULL_HOST blank for in-cluster-only deploys (it then
# falls back to IMAGE_REGISTRY_HOST).
IMAGE_REGISTRY_PULL_HOST=${DOMAIN}
IMAGE_REGISTRY_PULL_PORT=443

# Escape hatch for the synth-time pull-host guard. pipeline-manager fails the
# synth fast if the resolved CodeBuild pull host is an in-cluster/local name
# (registry, *.svc.cluster.local, localhost, …) that CodeBuild can't reach. Set
# this to true ONLY if your CodeBuild runs in a VPC whose private DNS genuinely
# resolves the in-cluster name. Leave unset for normal public-gateway pulls.
# ALLOW_INCLUSTER_PULL_HOST=true

# Memory limit for the rootless buildkitd sidecar — the cgroup the plugin's
# Dockerfile RUN steps execute in. Too low OOM-kills heavy builds
# (gradle/npm/dotnet) → "buildkit-runc … container not running". 3Gi fits the
# single-node instance (default t3.2xlarge 32G; min t3.xlarge 16G) alongside the
# rest of the stack; raise it on bigger instances. Applied to plugin.yaml at deploy.
BUILDKIT_MEMORY_LIMIT=3072Mi

# Basic auth used when image-registry talks to the underlying registry's
# management API. Match the registry's htpasswd entry (typically the same
# as IMAGE_REGISTRY_USER/TOKEN above). Wired into k8s via startup.sh
# `--from-literal=IMAGE_REGISTRY_USERNAME=$IMAGE_REGISTRY_USER`.
# (IMAGE_REGISTRY_USERNAME/PASSWORD removed — every target now derives the
#  registry basic-auth from IMAGE_REGISTRY_USER/IMAGE_REGISTRY_TOKEN above,
#  which gen-env-secrets actually generates.)

# Use plain HTTP for registry push. The in-cluster registry serves plain
# HTTP on its ClusterIP service; nginx fronts it on HTTPS for external
# clients. Both buildkit and crane talk to it over HTTP in-cluster.
IMAGE_REGISTRY_HTTP=true
IMAGE_REGISTRY_INSECURE=true


# ============================================================================
# Redis Configuration (Job Queue)
# ============================================================================
# Used by: plugin service (BullMQ job queue for Docker builds),
# compliance service (BullMQ compliance event queue)

# HA via Redis Sentinel is the DEFAULT here — the deploy ships redis-sentinel.yaml
# (3 data nodes + 3 Sentinels); the app tracks the current master via Sentinel
# and auto-fails-over. REDIS_PASSWORD / REDIS_SENTINEL_PASSWORD are optional.
# Do NOT also set REDIS_URL (setting both is a startup error), and REDIS_HOST /
# REDIS_PORT are not supported at all. The `redis` Service fronts ALL data
# nodes (incl. read-only replicas), so it must never be used for writes.
# Managed ElastiCache (cluster-mode disabled) has no Sentinel endpoint: for it,
# remove these two lines and set REDIS_URL=rediss://<primary-endpoint>:6379.
REDIS_SENTINELS=redis-sentinel-0.redis-sentinel-headless:26379,redis-sentinel-1.redis-sentinel-headless:26379,redis-sentinel-2.redis-sentinel-headless:26379
REDIS_SENTINEL_MASTER=mymaster

# Max concurrent Docker plugin builds (BullMQ worker concurrency)
PLUGIN_BUILD_CONCURRENCY=1

# ============================================================================
# Loki Configuration (Log Aggregation)
# ============================================================================

# Prometheus URL for the native Observability dashboards (sysadmin-only).
# Read by platform's /api/observability/query endpoint.
PROMETHEUS_URL=http://thanos-query:9090

# Per-org alert relay (Alertmanager -> platform POST /observability/alert-webhook).
# Bearer token Alertmanager presents as instance `alertmanager`. Generated by
# gen-env-secrets. The deploy wires it into BOTH sides: Alertmanager reads it
# from a mounted secret file (credentials_file in alertmanager.yml) and platform
# receives ALERT_WEBHOOK_INSTANCES=[{"id":"alertmanager","token":"<this>"}]
# built from it (docker-compose.yml / k8s/platform.yaml). Without it the relay
# answers 503 and per-org alert destinations never fire.
ALERT_WEBHOOK_INSTANCE_TOKEN=CHANGE_ME
# Rotation overlap ONLY (normally empty): the OUTGOING relay bearer. Platform
# accepts both while this is set, so Alertmanager can be restarted with the new
# token without dropping alerts. See docs/runbooks/secret-rotation.md
ALERT_WEBHOOK_INSTANCE_TOKEN_PREVIOUS=

# Ops-team Slack delivery for PLATFORM-WIDE alerts (severity=critical / warning).
# Independent of the per-org relay above — that one fans out to each tenant's own
# destinations; these two are the operator's channels.
#
# Alertmanager reads them as MOUNTED FILES, never as environment variables
# (it does not expand env vars in its config). The deploy puts them in the
# `alertmanager-slack` Secret / compose secret, and
# deploy/shared/config/alertmanager/alertmanager.yml points `api_url_file` at them — so the
# URLs never land in a world-readable ConfigMap.
#
# Create one incoming webhook per channel at
# https://api.slack.com/messaging/webhooks. Each URL IS a credential: anyone
# holding it can post to that channel. Map them to the channels named in
# alertmanager.yml — critical → #ops-pager, warning → #ops-warnings.
#
# SETUP REFUSES TO DEPLOY while either still reads CHANGE_ME: an alert pipeline
# that 404s into nothing looks identical to a healthy one, so this is a hard
# gate rather than a runtime warning. To run deliberately without ops-team Slack
# (local dev, or a site that only uses per-org destinations), set BOTH to an
# EMPTY value — setup then prints a banner saying platform-wide alerts will be
# visible only in Alertmanager's own UI/API, and continues.
SLACK_CRITICAL_WEBHOOK_URL=CHANGE_ME
SLACK_WARNING_WEBHOOK_URL=CHANGE_ME

# ============================================================================
# Billing Configuration
# ============================================================================

# Enable/disable billing service (true | false)
# Code defaults to 'true'; set 'false' for local dev to disable billing routes
BILLING_ENABLED=false

# Billing service hostname (K8s service name)
BILLING_SERVICE_HOST=billing

# Billing service port
BILLING_SERVICE_PORT=3000

# Billing provider selection (stub | aws-marketplace | stripe)
# Use 'stub' for local development (no-op provider)
BILLING_PROVIDER=stub

# AWS Marketplace config (only needed when BILLING_PROVIDER=aws-marketplace)
AWS_MARKETPLACE_PRODUCT_CODE=
AWS_MARKETPLACE_REGION=us-east-1
# Comma-separated — set BOTH AWS-owned topics from the listing's Product summary
# (subscribe/unsubscribe + entitlement-updated); unlisted topics are rejected:
#   arn:aws:sns:us-east-1:287250355862:aws-mp-subscription-notification-<product-code>,arn:aws:sns:us-east-1:287250355862:aws-mp-entitlement-notification-<product-code>
AWS_MARKETPLACE_SNS_TOPIC_ARN=
AWS_MARKETPLACE_DIMENSION_MAP=
AWS_MARKETPLACE_BUNDLE_DIMENSION_MAP=
# Marketplace add-on metering (BatchMeterUsage). Off by default; enable only
# once the listing's metered dimensions match AWS_MARKETPLACE_BUNDLE_DIMENSION_MAP.
BILLING_METERING_ENABLED=false
BILLING_METERING_INTERVAL_MS=3600000

# Stripe config (only needed when BILLING_PROVIDER=stripe). Declared and EMPTY,
# the same convention as the AWS Marketplace block above: conditional provider
# config is always DECLARED so an operator can see what the provider needs, and
# left empty so no illustrative value can ship as a real one. Billing reads each
# with `|| ''`, so empty and unset are the same thing to it.
# Format: sk_test_... / sk_live_...
STRIPE_SECRET_KEY=
# Format: whsec_...
STRIPE_WEBHOOK_SECRET=
# JSON map of plan keys to Stripe Price ids, e.g.
# {"developer_monthly":"price_xxx","developer_annual":"price_xxx","pro_monthly":"price_xxx","pro_annual":"price_xxx","team_monthly":"price_xxx","team_annual":"price_xxx","enterprise_monthly":"price_xxx","enterprise_annual":"price_xxx"}
STRIPE_PRICE_MAP=

# ============================================================================
# Billing Plan Pricing (in cents)
# ============================================================================
# Override default plan prices per environment.
# Defaults match the standard tier pricing.

# Developer plan (free tier)
BILLING_PLAN_DEVELOPER_MONTHLY=0
BILLING_PLAN_DEVELOPER_ANNUAL=0

# Pro plan
BILLING_PLAN_PRO_MONTHLY=3900
BILLING_PLAN_PRO_ANNUAL=39000

# Team plan
BILLING_PLAN_TEAM_MONTHLY=7900
BILLING_PLAN_TEAM_ANNUAL=79000

# Enterprise plan
BILLING_PLAN_ENTERPRISE_MONTHLY=59900
BILLING_PLAN_ENTERPRISE_ANNUAL=599000

# Plan display names (optional overrides)
# BILLING_PLAN_DEVELOPER_NAME=Developer
# BILLING_PLAN_PRO_NAME=Pro
# BILLING_PLAN_TEAM_NAME=Team
# BILLING_PLAN_ENTERPRISE_NAME=Enterprise

# Plan descriptions (optional overrides)
# BILLING_PLAN_DEVELOPER_DESCRIPTION=Free starter tier for individual developers
# BILLING_PLAN_PRO_DESCRIPTION=For individual power users and production workloads
# BILLING_PLAN_TEAM_DESCRIPTION=For teams that need collaboration and shared quotas
# BILLING_PLAN_ENTERPRISE_DESCRIPTION=No restrictions for enterprise teams

# Plan features (optional JSON array overrides)
# BILLING_PLAN_DEVELOPER_FEATURES=["Up to 50 plugins","Up to 5 pipelines","1 seat","Community support"]
# BILLING_PLAN_PRO_FEATURES=["Up to 500 plugins","Up to 50 pipelines","3 seats","Reporting dashboard"]
# BILLING_PLAN_TEAM_FEATURES=["Up to 2,000 plugins","Up to 200 pipelines","10 seats","RBAC & team roles","Audit log","Priority support"]
# BILLING_PLAN_ENTERPRISE_FEATURES=["Unlimited plugins","Unlimited pipelines","Unlimited seats","Priority support","Reporting dashboard","Custom integrations"]

# ============================================================================
# Discounts (docs/billing-discounts.md) — discount codes + usage credits
# ============================================================================
# In-app discount management (Stripe only). On by default; set false to disable.
# BILLING_DISCOUNTS_ENABLED=true
#
# AES-256-GCM signing keys for opaque discount tokens — REQUIRED to issue Mode-B
# tokens. Comma-separated versioned 32-byte base64 keys (highest version mints;
# older keys still decode, for rotation). SECRET — provision via a sealed
# secret; never commit a real value.
# BILLING_DISCOUNT_KEYS=v1:<base64-32-byte-key>
#
# Mint-time ceilings — reject discounts above these (percent 1-100; cents).
# BILLING_DISCOUNT_MAX_PERCENT=100
# BILLING_DISCOUNT_MAX_CENTS=10000000
#
# ============================================================================
# Add-on Bundles (docs/billing-bundles.md) — purchasable packs on top of a plan
# ============================================================================
# In-app bundle management (Stripe only). Off by default.
BILLING_BUNDLES_ENABLED=true
#
# Per-bundle price overrides (cents): BILLING_BUNDLE_<ID>_MONTHLY / _ANNUAL.
# Defaults shown (annual ~= 10x monthly):
# BILLING_BUNDLE_SEAT_PACK_MONTHLY=2500       # +5 seats
# BILLING_BUNDLE_PIPELINE_PACK_MONTHLY=1500   # +10 pipelines
# BILLING_BUNDLE_PLUGIN_PACK_MONTHLY=1500     # +100 plugins
# BILLING_BUNDLE_API_PACK_MONTHLY=2000        # +1M API calls
# BILLING_BUNDLE_AI_PACK_MONTHLY=7500         # +5k AI calls
# BILLING_BUNDLE_STORAGE_PACK_MONTHLY=2500    # +50 GB
# BILLING_BUNDLE_RETENTION_PACK_MONTHLY=1500     # +90 days standard event retention (annual auto-derives 10x)
# BILLING_BUNDLE_DORA_HISTORY_PACK_MONTHLY=3000  # +365 days DORA history + report-query window
# BILLING_BUNDLE_COMPLIANCE_STANDARD_MONTHLY=2990   # Standard Compliance (curated ~20-rule CI/CD best-practice library; annual 29900)
# BILLING_BUNDLE_COMPLIANCE_ADVANCED_MONTHLY=9990   # Advanced Compliance (SOC2/PCI/CIS framework libraries; requires Standard; annual 99900)
# BILLING_COMBO_COMPLIANCE_SUITE_MONTHLY=9086       # Compliance Suite combo (Standard + Advanced, 30% off; annual 90860)
#
# Per-bundle grant overrides: BILLING_BUNDLE_<ID>_GRANT retunes how much a
# single-dimension pack grants per unit (defaults shown). Ignored for the
# feature bundles (advanced_reporting, team_usage_analytics, compliance_*).
# BILLING_BUNDLE_SEAT_PACK_GRANT=5            # seats per pack
# BILLING_BUNDLE_PIPELINE_PACK_GRANT=10       # pipelines per pack
# BILLING_BUNDLE_PLUGIN_PACK_GRANT=100        # plugins per pack
# BILLING_BUNDLE_API_PACK_GRANT=1000000       # API calls per pack
# BILLING_BUNDLE_AI_PACK_GRANT=5000           # AI calls per pack
# BILLING_BUNDLE_STORAGE_PACK_GRANT=53687091200  # storage bytes per pack (50 GB)
# BILLING_BUNDLE_RETENTION_PACK_GRANT=90         # +days standard event retention per pack
# BILLING_BUNDLE_DORA_HISTORY_PACK_GRANT=365     # +days DORA retention (and query window) per pack
#
# Per-bundle purchasable-tier override: BILLING_BUNDLE_<ID>_TIERS is a JSON
# array of tiers allowed to buy the bundle. Capacity packs (seat/pipeline/
# plugin) default to all tiers; feature/rate packs are tier-scoped.
# BILLING_BUNDLE_SEAT_PACK_TIERS=["team","enterprise"]   # Seat Pack is Team+ by default (prevents undercutting Team)

# ============================================================================
# Internal Service Timeouts
# ============================================================================

# Handler timeout (milliseconds): api-server defaults 30000, pipeline-core defaults 25000
HANDLER_TIMEOUT_MS=30000

# ============================================================================
# Message Routing
# ============================================================================
# Comma-separated email-like aliases that resolve to the system org
SUPPORT_ALIASES=support@pipeline-builder,help@pipeline-builder

# ============================================================================
# AWS CDK / Lambda Configuration
# ============================================================================
# Used by pipeline-core for CDK infrastructure builds

# Lambda runtime version
LAMBDA_RUNTIME=nodejs24.x

# Lambda timeout in seconds (max 900 = 15 minutes)
LAMBDA_TIMEOUT=900

# Lambda memory size in MB
LAMBDA_MEMORY_SIZE=512

# Lambda architecture (ARM_64 | x86_64)
LAMBDA_ARCHITECTURE=ARM_64

# ============================================================================
# AWS CloudWatch / CodeBuild Configuration
# ============================================================================

# CloudWatch log group name
LOG_GROUP_NAME=/pipeline-builder/logs

# CodeBuild compute type (SMALL | MEDIUM | LARGE | X2_LARGE)
CODEBUILD_COMPUTE_TYPE=SMALL

# CodeBuild image used when a step has no plugin-baked image (cold-start
# synth bootstrap, ShellSteps with no registry image, metadata_only plugins).
#
# Resolution:
#   - Bare tag (no `/`)  → auto-prefixed at synth time to
#     `<IMAGE_REGISTRY_HOST>:<port>/library/<tag>` with per-org platform
#     Secret as Basic auth. This is the normal path — leave as-is.
#   - Fully-qualified URI (contains `/`) → used as-is, no auth wired.
#     Use this to point at ECR or a private mirror outside the platform
#     registry. The operator owns making it pullable from CodeBuild.
#
# The image MUST have `pipeline-manager` on PATH. `pipeline-bootstrap:1.0`
# (built by deploy/bin/build-codebuild-bootstrap.sh) is the supported
# default; cold-start synth will exit 127 against any image that doesn't.
# To cut a NEW version, build with BOOTSTRAP_IMAGE_TAG=pipeline-bootstrap:<ver>
# and set this to the SAME tag (a mismatch fails the image pull at synth).
CODEBUILD_DEFAULT_IMAGE=pipeline-bootstrap:1.0

# ============================================================================
# HTTP Client Configuration
# ============================================================================
# Used by: api-core internal HTTP client for service-to-service communication

# HTTP client timeout in milliseconds (default: 5000)
# HTTP_CLIENT_TIMEOUT=5000

# Maximum retry attempts for failed HTTP requests (default: 2)
# HTTP_CLIENT_MAX_RETRIES=2

# Delay between retries in milliseconds (default: 200)
# HTTP_CLIENT_RETRY_DELAY_MS=200

# ============================================================================
# SSE (Server-Sent Events) Configuration
# ============================================================================
# Used by: api-server SSE connection manager

# Maximum SSE clients per request (default: 10)
# SSE_MAX_CLIENTS_PER_REQUEST=10

# SSE client timeout in milliseconds (default: 1800000 = 30 minutes)
# SSE_CLIENT_TIMEOUT_MS=1800000

# SSE cleanup interval in milliseconds (default: 300000 = 5 minutes)
# SSE_CLEANUP_INTERVAL_MS=300000

# ============================================================================
# Plugin Build Queue Configuration
# ============================================================================
# Used by: plugin service BullMQ job queue

# Queue name for plugin builds (default: plugin-build)
# PLUGIN_BUILD_QUEUE_NAME=plugin-build

# Maximum build attempts before failing (default: 2)
# PLUGIN_BUILD_MAX_ATTEMPTS=2

# Exponential backoff delay in milliseconds (default: 5000)
# PLUGIN_BUILD_BACKOFF_DELAY_MS=5000

# Completed job retention in seconds (default: 3600 = 1 hour)
# PLUGIN_BUILD_COMPLETED_RETENTION_SECS=3600

# Failed job retention in seconds (default: 86400 = 24 hours)
# PLUGIN_BUILD_FAILED_RETENTION_SECS=86400

# Worker ready timeout in milliseconds (default: 10000)
# PLUGIN_BUILD_WORKER_TIMEOUT_MS=10000

# Dead letter queue: max retry attempts (default: 3)
# PLUGIN_DLQ_MAX_ATTEMPTS=3

# Dead letter queue: backoff base delay in ms (default: 300000 = 5 min)
# PLUGIN_DLQ_BACKOFF_BASE_MS=300000

# Dead letter queue: max queue size (default: 20)
# PLUGIN_DLQ_MAX_SIZE=20

# Per-tier worker concurrency (default: PLUGIN_BUILD_CONCURRENCY for each tier)
# PLUGIN_BUILD_CONCURRENCY_DEVELOPER=1
# PLUGIN_BUILD_CONCURRENCY_PRO=1
# PLUGIN_BUILD_CONCURRENCY_TEAM=1
# PLUGIN_BUILD_CONCURRENCY_ENTERPRISE=1
# PLUGIN_BUILD_CONCURRENCY_UNLIMITED=1

# Max in-flight builds per org across all workers (default: 3); an org over the
# cap is re-delayed by PLUGIN_ORG_SLOT_DELAY_MS so other orgs' builds run.
# PLUGIN_MAX_BUILDS_PER_ORG=3
# PLUGIN_ORG_SLOT_DELAY_MS=10000

# ============================================================================
# Docker Build Configuration
# ============================================================================
# Used by: plugin service for building plugin Docker images

# Plugin builds run on a rootless buildkitd sidecar; no strategy switch.
# `buildctl` connects to it via the path in BUILDKIT_HOST.
# BUILDKIT_HOST is set per-target in the manifest/compose (unix socket in k8s
# plugin.yaml; tcp://buildkitd:1234 in docker-compose), so this key is unused here.
# BUILDKIT_HOST=unix:///run/buildkit/buildkitd.sock
# Docker build timeout in milliseconds (default: 900000 = 15 min)
DOCKER_BUILD_TIMEOUT_MS=900000

# Docker push timeout in milliseconds (default: 300000 = 5 minutes)
# DOCKER_PUSH_TIMEOUT_MS=300000

# Plugin upload HTTP timeout in milliseconds (default: 300000 = 5 min)
# Applies only to the upload route  overrides HANDLER_TIMEOUT_MS for large ZIPs.
# PLUGIN_UPLOAD_TIMEOUT_MS=300000

# Shared temp directory for Docker builds (must match pod volumeMount).
# Defaults to $PIPELINE_DATA_DIR/plugins-data (set by startup.sh).
# DOCKER_BUILD_TEMP_ROOT=/opt/pipeline/pipeline-data/plugins-data

# Plugin upload staging directory (multer dest). Must be a writable absolute
# path inside the plugin container — the container runs with
# readOnlyRootFilesystem=true, so a relative path like `uploads/` resolves
# to /app/uploads on the read-only root and EROFS-fails. Defaults to
# /opt/pipeline/pipeline-data/plugins-data (matches the k8s
# volumeMount for the uploads volume).
# PLUGIN_UPLOAD_DIR=/opt/pipeline/pipeline-data/plugins-data

# Plugin max upload size in MB (default: 1024 = 1GB, supports prebuilt image.tar in zip)
# PLUGIN_MAX_UPLOAD_MB=1024

# Plugin build strategy: build_image (default) or prebuilt
# PLUGIN_BUILD_STRATEGY=build_image

# ============================================================================
# Pagination & Limits
# ============================================================================
# Used by: api-core validation, pipeline-core, platform controllers

# Maximum page limit for paginated queries (default: 1000)
# MAX_PAGE_LIMIT=1000

# Default page limit when not specified (default: 100)
# DEFAULT_PAGE_LIMIT=100

# Maximum AI prompt length in characters (default: 5000)
# MAX_PROMPT_LENGTH=5000

# Maximum pipeline name length (default: 100)
# PIPELINE_NAME_MAX_LENGTH=100

# Default plugin version when not specified (default: 1.0.0)
# DEFAULT_PLUGIN_VERSION=1.0.0

# ============================================================================
# Database Connection Retries
# ============================================================================
# Used by: pipeline-data PostgreSQL connection manager

# Maximum connection retry attempts (default: 3)
# DB_MAX_RETRIES=3

# Delay between connection retries in milliseconds (default: 1000)
# DB_RETRY_DELAY_MS=1000

# ============================================================================
# Google OAuth URL Overrides
# ============================================================================
# Override default Google OAuth endpoints (useful for custom OAuth providers)

# GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v2/userinfo

# OAuth CSRF state cleanup interval in milliseconds (default: 60000)
# OAUTH_CLEANUP_INTERVAL_MS=60000

# ============================================================================
# AI / LLM Configuration
# ============================================================================

# Cloud AI providers (uncomment to enable)
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key
# XAI_API_KEY=your-xai-api-key

# ============================================================================
# Git URL Analysis Configuration
# ============================================================================
# Used by: pipeline service for Git URL-based pipeline generation

# GitHub REST API base URL (override for GitHub Enterprise)
# GITHUB_API_BASE_URL=https://api.github.com

# Bitbucket REST API base URL (override for Bitbucket Server)
# BITBUCKET_API_BASE_URL=https://api.bitbucket.org/2.0

# ============================================================================
# AI Generation SSE Configuration
# ============================================================================
# Used by: pipeline, plugin services for AI streaming generation

# SSE stream timeout in milliseconds (default: 300000 = 5 minutes)
# SSE_STREAM_TIMEOUT_MS=300000

# ============================================================================
# Plugin Service Discovery (for auto-plugin creation)
# ============================================================================
# Used by: pipeline service to call plugin service for auto-creating missing plugins

# Plugin service hostname (Docker service name)
PLUGIN_SERVICE_HOST=plugin

# Plugin service port
PLUGIN_SERVICE_PORT=3000

# ============================================================================
# Pipeline Service Discovery
# ============================================================================
# Used by: platform service for pipeline operations

# Pipeline service hostname (Docker service name)
PIPELINE_SERVICE_HOST=pipeline

# Pipeline service port
PIPELINE_SERVICE_PORT=3000

# ============================================================================
# Message Service Discovery
# ============================================================================
# Used by: billing service, platform service for WebSocket messaging

# Message service hostname (Docker service name)
MESSAGE_SERVICE_HOST=message

# Message service port
MESSAGE_SERVICE_PORT=3000

# ============================================================================
# Compliance Service Configuration
# ============================================================================
# Used by: plugin, pipeline, platform services for compliance checks

# Compliance service hostname (Docker service name)
COMPLIANCE_SERVICE_HOST=compliance

# Compliance service port
COMPLIANCE_SERVICE_PORT=3000

# Bypass compliance checks when service is unavailable (true | false)
# WARNING: Only enable for local development or disaster recovery
COMPLIANCE_BYPASS=false

# Compliance scan scheduler interval in milliseconds (default: 60000 = 1 minute)
# SCAN_SCHEDULER_INTERVAL_MS=60000

# Cross-pod leader-lock TTL for the scan scheduler in ms (default: 300000 = 5 min).
# With multiple compliance replicas only one pod sweeps per tick; raise this if a
# scan cycle can legitimately run longer than the TTL.
# SCAN_LOCK_TTL_MS=300000

# Compliance notification digest scheduler interval in ms (default: 3600000 = 1 hour).
# How often parked daily/weekly digests are checked for delivery.
# DIGEST_SCHEDULER_INTERVAL_MS=3600000

# Cross-pod leader-lock TTL for the digest scheduler in ms (default: 300000 = 5 min).
# DIGEST_LOCK_TTL_MS=300000

# ============================================================================
# Plugin Build Temp Directory
# ============================================================================
# Used by: plugin service temp directory cleanup

# Maximum age for temp build dirs before cleanup in ms (default: 3600000 = 1 hour)
# TEMP_DIR_MAX_AGE_MS=14400000

# ============================================================================
# Additional Configuration (not set by default)
# ============================================================================

# PLUGIN_MAX_UPLOAD_MB=50
# AUTH_LIMITER_MAX=5
# AUTH_LIMITER_WINDOWMS=900000
# BILLING_SERVICE_TIMEOUT=30000
# QUOTA_SERVICE_TIMEOUT=30000

# =============================================================================
# Reporting & Audit
# =============================================================================
# AUDIT_RETENTION_DAYS=90

# =============================================================================
# Response Compression
# =============================================================================
# Minimum response size in bytes before gzip compression is applied (default: 1024)
# COMPRESSION_THRESHOLD_BYTES=1024

# =============================================================================
# Idempotency Configuration
# =============================================================================
# TTL for cached idempotent responses in milliseconds (default: 300000 = 5 minutes)
# IDEMPOTENCY_TTL_MS=300000

# How long an IN-FLIGHT idempotency reservation holds its key if the process dies
# mid-request (retries get 409 until then). Keep above the slowest handler (default: 120000 = 2 minutes)
# IDEMPOTENCY_PENDING_TTL_MS=120000

# Maximum number of idempotent responses stored in memory (default: 10000)
# IDEMPOTENCY_MAX_STORE_SIZE=10000

# Cleanup interval for expired idempotency entries in ms (default: 60000 = 1 minute)
# IDEMPOTENCY_CLEANUP_INTERVAL_MS=60000

# =============================================================================
# Cache Configuration
# =============================================================================
# In-memory cache cleanup interval in milliseconds (default: 30000 = 30 seconds)
# CACHE_CLEANUP_INTERVAL_MS=30000

# =============================================================================
# SSE Backpressure
# =============================================================================
# Number of consecutive write failures before disconnecting slow SSE clients (default: 10)
# SSE_BACKPRESSURE_THRESHOLD=10

# =============================================================================
# HTTP Cache-Control Headers
# =============================================================================
# Cache-Control header for list/filter endpoints (default: private, max-age=30, stale-while-revalidate=60)
# CACHE_CONTROL_LIST=private, max-age=30, stale-while-revalidate=60

# Cache-Control header for detail endpoints (default: private, max-age=60, stale-while-revalidate=120)
# CACHE_CONTROL_DETAIL=private, max-age=60, stale-while-revalidate=120

# =============================================================================
# OpenTelemetry Tracing
# =============================================================================
# Enable OpenTelemetry distributed tracing. On by default — audit events + logs
# are stamped with a trace id (see helpers/audit.ts) and exported to the bundled
# `jaeger` collector (manifests in k8s/jaeger.yaml). These lines feed the
# app-env ConfigMap (built from this file, comments stripped) and are injected
# into the services via envFrom. Set to false to opt out. Browse traces with:
#   kubectl -n pipeline-builder port-forward svc/jaeger 16686:16686
OTEL_TRACING_ENABLED=true

# OTLP exporter endpoint — the in-cluster jaeger Service (OTLP/HTTP on 4318).
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# =============================================================================
# Service Tunables  added by the hard-coded-values refactor
# =============================================================================
# Every value below has a sensible default baked into the code; set only when
# you need to deviate. Grouped by service for easy targeting.

# --- Platform ---------------------------------------------------------------
# Timeout for Alertmanager API calls (default: 5000)
# ALERTMANAGER_TIMEOUT_MS=5000
# Platform org/user count scraper interval (default: 60000)
# PLATFORM_SCRAPER_INTERVAL_MS=60000
# Per-destination delivery timeout from the alertmanager-relay (default: 5000)
# ALERT_DELIVERY_TIMEOUT_MS=5000
# Email verification token TTL (default: 86400000 = 24h)
# AUTH_VERIFICATION_TOKEN_TTL_MS=86400000
# Max in-memory OAuth state map size (default: 1000)
# OAUTH_MAX_PENDING_STATES=1000
# Dashboard field caps (defaults: name=150, description=1000, panel title=200, panels=50)
# DASHBOARD_MAX_NAME=150
# DASHBOARD_MAX_DESCRIPTION=1000
# DASHBOARD_MAX_PANEL_TITLE=200
# DASHBOARD_MAX_PANELS=50
# Alert destination field caps (defaults: label=100, target URL=2048)
# ALERT_DESTINATION_MAX_LABEL=100
# ALERT_DESTINATION_MAX_TARGET=2048
# org-cascade HTTP timeout to quota/billing (default: 5000)
# ORG_CASCADE_HTTP_TIMEOUT_MS=5000

# --- Plugin -----------------------------------------------------------------
# per-tier worker queue cache TTL  how long the worker caches an
# org's tier before re-fetching from the quota service (default: 300000 = 5min)
# PLUGIN_TIER_CACHE_TTL_MS=300000
# Per-org build slot TTL (default: 900 seconds)
# PLUGIN_ORG_SLOT_TTL_SEC=900
# Queue-metrics scraper interval (default: 15000)
# PLUGIN_QUEUE_METRICS_INTERVAL_MS=15000

# --- Pipeline ---------------------------------------------------------------
# Timeout for pipeline → plugin service calls (default: 30000)
# PIPELINE_PLUGIN_SERVICE_TIMEOUT_MS=30000
# Org-wide scorecard roll-up bounds (defaults: 50 pipelines, 4 in parallel)
# ORG_SCORECARD_MAX_PIPELINES=50
# ORG_SCORECARD_CONCURRENCY=4

# --- Image Registry ---------------------------------------------------------
# Read timeout for blob streaming (default: 30000)
# REGISTRY_BLOB_STREAM_TIMEOUT_MS=30000
# Storage-rollup cache TTL (default: 60000)
# REGISTRY_STORAGE_CACHE_TTL_MS=60000
# Blob proxy size cap (default: 5242880 = 5 MB)
# REGISTRY_MAX_BLOB_PROXY_BYTES=5242880
# Cross-repo copy parallelism (defaults: children=3, blobs=8)
# REGISTRY_COPY_PARALLEL_CHILDREN=3
# REGISTRY_COPY_PARALLEL_BLOBS=8
# Scheduled registry GC — destructive, OFF by default. Prunes manifests older
# than MAX_AGE_DAYS every INTERVAL_HOURS, first sweep STARTUP_DELAY_MS after boot.
# REGISTRY_GC_ENABLED=false
# REGISTRY_GC_INTERVAL_HOURS=24
# REGISTRY_GC_MAX_AGE_DAYS=30
# REGISTRY_GC_STARTUP_DELAY_MS=300000

# --- Compliance -------------------------------------------------------------
# Cap on user-supplied regex patterns (default: 200)
# COMPLIANCE_MAX_REGEX_LENGTH=200
# Compliance validate-attribute caps (defaults: keys=100, depth=5)
# COMPLIANCE_MAX_ATTRIBUTE_KEYS=100
# COMPLIANCE_MAX_ATTRIBUTE_DEPTH=10
# Scan executor progress batch size (default: 10)
# COMPLIANCE_SCAN_PROGRESS_BATCH_SIZE=10

# --- Billing ----------------------------------------------------------------
# cost-attribution fallback window for orgs with no active sub (default: 30 days)
# BILLING_USAGE_FALLBACK_DAYS=30

# --- Quota ------------------------------------------------------------------
# TTL for the GET /quotas/at-risk computation cache (default: 60000 = 60s).
# Raise on large fleets to reduce per-org quota recomputation cost; lower for
# fresher operator dashboards.
# QUOTA_AT_RISK_CACHE_TTL_MS=60000

# --- Message (SSE notifications) --------------------------------------------
# Hard cap on total live SSE tickets across the message process; bounds
# memory under abuse (default: 1000).
# SSE_MAX_TOTAL_TICKETS=1000
# Per-org cap on live SSE tickets; prevents a single tenant from
# saturating the ticket table (default: 10).
# SSE_MAX_TICKETS_PER_ORG=10

# --- Advanced / multi-replica tunables (optional) ---------------------
# Safe to leave unset (defaults shown). These tune behavior that matters
# only under horizontal scaling (>1 replica) or high load. NOTE: OAuth/SSO
# login CSRF state + nonce, SSE build-log delivery, step-up single-use, and
# the background leader locks all use the shared Redis (configured above)
# when running multi-replica; without Redis they degrade to per-pod behavior
# (correct only on a single replica).
#
# Pipeline execution-trigger idempotency window (seconds): a duplicate
# POST /pipelines/:id/executions within this window is a no-op, not a second
# CodePipeline run (default: 60).
# PIPELINE_EXEC_IDEMPOTENCY_WINDOW_SECONDS=60
#
# Billing webhook in-progress lock TTL (seconds): a crash mid-processing
# releases the claim after this so the provider's retry re-runs the event's
# side-effects instead of being dropped as a duplicate (default: 300).
# BILLING_WEBHOOK_INPROGRESS_TTL_SECONDS=300
#
# Compliance validate per-attempt timeout (ms): validation is fail-closed and
# now retried, so a transient blip doesn't reject a legit upload/create
# (default: 4000).
# COMPLIANCE_VALIDATE_TIMEOUT_MS=4000
#
# Max sockets per internal HTTP keep-alive agent (default: 64).
# HTTP_CLIENT_MAX_SOCKETS=64
#
# Image-registry GC leader-lock TTL (ms): only one replica runs the
# destructive GC sweep at a time (default: 900000 = 15 min).
# REGISTRY_GC_LOCK_TTL_MS=900000
#
# Soft-delete retention purge: deleted pipelines/plugins are kept for a
# retention window, then a leader-locked per-service sweep (pipeline + plugin
# services) hard-deletes the tombstones. All values have working defaults;
# uncomment to override.
#
# Master kill-switch: false keeps tombstones forever (nothing is hard-purged;
# rows stay restorable). Default: true.
# SOFT_DELETE_PURGE_ENABLED=true
#
# Days a deleted row stays restorable before it becomes purge-eligible (stamped
# into purge_after at delete time). Default: 30. 0 disables the deadline.
# SOFT_DELETE_RETENTION_DAYS=30
#
# Hours between purge sweeps (default: 6).
# SOFT_DELETE_PURGE_INTERVAL_HOURS=6
#
# Delay (ms) before the first sweep after startup, so migrations/DB settle
# first (default: 120000 = 2 min).
# SOFT_DELETE_PURGE_STARTUP_DELAY_MS=120000
#
# Purge leader-lock TTL (ms): only one replica sweeps per window
# (default: 900000 = 15 min).
# SOFT_DELETE_PURGE_LOCK_TTL_MS=900000

# --- Secret Encryption ------------------------------------------------
# 32-byte master key for AES-256-GCM envelope encryption of secret columns
# (aiProviderKeys, IdP client secrets). Accepts hex (64 chars) or base64
# (44 chars). REQUIRED whenever NODE_ENV=production (i.e. every deploy):
# platform refuses to boot without it. Filled with a fresh random value by
# deploy/bin/gen-env-secrets.sh, so leave the placeholder alone unless you are
# supplying your own. Rotating it makes previously-encrypted secrets
# undecryptable — re-enter AI provider keys and IdP client secrets after a change.
SECRET_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32
# Rotation overlap ONLY (normally empty): the OUTGOING SECRET_ENCRYPTION_KEY.
# Used for DECRYPT ONLY — new writes always use the current key. Clear it after
# `node scripts/reencrypt-secrets.js` reports 0 failures inside the platform
# container; until then stored secrets are still wrapped under the old key.
# See docs/runbooks/secret-rotation.md
SECRET_ENCRYPTION_KEY_PREVIOUS=

# --- Audit tamper evidence ------------------------------------------------
# HMAC key for the audit hash chain (every audit event links to the previous
# one via HMAC-SHA256 under this key). It lives HERE — outside the database —
# so someone with write access to Mongo alone cannot rebuild a consistent chain
# after editing or deleting events. >= 32 chars; platform refuses to boot
# without it under NODE_ENV=production. Filled by deploy/bin/gen-env-secrets.sh.
# Changing it invalidates verification of every existing link.
AUDIT_CHAIN_HMAC_KEY=CHANGE_ME

# Signed chain-head export to WRITE-ONCE object storage: every
# AUDIT_HEAD_EXPORT_INTERVAL_MS platform publishes each audit chain's head
# (HMAC-signed with AUDIT_CHAIN_HMAC_KEY) to the MinIO `audit-heads` bucket,
# created WITH Object Lock by minio-init; /audit/verify compares against it, which
# is what detects someone deleting the NEWEST audit events. The bucket-scoped
# user may only Put/Get (no delete); under COMPLIANCE lock not even it can
# shorten a head's retention. Unset the endpoint to disable (verify then cannot
# detect tail truncation).
AUDIT_HEAD_EXPORT_S3_ENDPOINT=http://minio:9000
AUDIT_HEAD_EXPORT_S3_BUCKET=audit-heads
AUDIT_HEAD_EXPORT_S3_REGION=us-east-1
AUDIT_HEAD_EXPORT_S3_ACCESS_KEY_ID=audit-heads-svc
AUDIT_HEAD_EXPORT_S3_SECRET_ACCESS_KEY=CHANGE_ME
AUDIT_HEAD_EXPORT_PREFIX=audit-heads
# COMPLIANCE | GOVERNANCE | none (none only for storage without Object Lock).
AUDIT_HEAD_EXPORT_LOCK_MODE=COMPLIANCE
AUDIT_HEAD_EXPORT_RETENTION_DAYS=400
AUDIT_HEAD_EXPORT_INTERVAL_MS=300000
# How often platform drains the durable Redis audit spool into Mongo.
AUDIT_SPOOL_DRAIN_INTERVAL_MS=30000

# --- buildkitd --------------------------------------------------------
# All deploys ship a single shared `buildkitd` sidecar in the plugin pod.
# Tier partitioning lives at the BullMQ queue level inside the plugin
# service (developer / pro / team / enterprise queues); every tier's worker
# dispatches to the same buildkitd via the unix socket set on
# BUILDKIT_HOST in plugin.yaml. Operators who want kernel-namespace
# isolation per tier can restore standalone Deployments and set
# PLUGIN_BUILDKIT_ADDR_<TIER> env vars; see docker-build.ts for details.
# =============================================================================
# MinIO / S3 object storage (message attachments, registry, loki, thanos)
# =============================================================================
# MinIO admin creds (server + minio-init bootstrap only). CHANGE for anything
# beyond local dev. Each service uses its OWN bucket-scoped key below.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
# S3 endpoint the services talk to (in-cluster MinIO).
S3_ENDPOINT=http://minio:9000
# Per-service, bucket-scoped keys. These values are REAL: bin/k8s-resources.sh
# builds the `minio-secret` Secret from them, so they are what the server and
# every service actually authenticate with. (They used to be inert here — a
# literal Secret in k8s/minio.yaml shipped `minioadmin` and predictable
# `*-svc-secret` values that overrode anything set in this file.)
# The CHANGE_ME secrets are filled with fresh random values by
# deploy/bin/gen-env-secrets.sh on first provision; the access-key *names* are
# not secrets and stay readable.
MESSAGE_S3_ACCESS_KEY=message-svc
MESSAGE_S3_SECRET_KEY=CHANGE_ME
REGISTRY_S3_ACCESS_KEY=registry-svc
REGISTRY_S3_SECRET_KEY=CHANGE_ME
# Shared HTTP secret of the registry replicas (signs upload-session state, so a
# multi-replica registry needs ONE value across pods). Registry-only: it goes
# into registry-token-secret, never app-secrets. Filled by gen-env-secrets.sh.
REGISTRY_HTTP_SECRET=CHANGE_ME
LOKI_S3_ACCESS_KEY=loki-svc
LOKI_S3_SECRET_KEY=CHANGE_ME
THANOS_S3_ACCESS_KEY=thanos-svc
THANOS_S3_SECRET_KEY=CHANGE_ME
# Build-context bucket for the plugin service. Present in the manifests
# (k8s/plugin.yaml reads plugin-access-key) but was missing from this file, so
# the Secret had no source for it once it moved out of k8s/minio.yaml.
PLUGIN_S3_ACCESS_KEY=plugin-svc
PLUGIN_S3_SECRET_KEY=CHANGE_ME
# Max message-attachment size (MiB).
MESSAGE_ATTACHMENT_MAX_MB=10

# --- Reporting & DORA (optional — defaults shown; see docs/environment-variables.md) ---
# DORA_INCIDENT_WINDOW_HOURS=24          # deploy<->incident correlation window (per-org override in dora_settings)
# REPORTING_RETENTION_ENABLED=true       # set false to keep ALL reporting history forever
# REPORTING_EVENT_RETENTION_DAYS=30      # standard pipeline-event retention (per-org override)
# REPORTING_DORA_RETENTION_DAYS=180      # DORA-source (deploy/outcome/incident) retention (per-org override)
# REPORTING_RETENTION_INTERVAL_HOURS=12  # how often the retention sweep runs

# ============================================================================
# Grafana (optional admin UI — dropped by LEAN)
# ============================================================================
# Grafana has its OWN login because nginx applies no auth to /grafana/ (same as
# /pgadmin/). It reads Prometheus directly with no org scoping, so anyone who
# gets in sees every tenant's metrics — hence a generated password, not a
# shipped default.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Kiali session-signing key (auth.strategy=token). MUST be exactly 16, 24 or 32
# bytes — Kiali refuses to start otherwise. Generated as 32 hex chars.
KIALI_SIGNING_KEY=CHANGE_ME
