  {
   "id": 26,
   "type": "stat",
   "title": "Rule evaluation failures",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 79,
    "w": 8,
