   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "ztunnel exports no deny counter, so the waypoint is the only direct view of policy rejecting traffic."
  },
  {
