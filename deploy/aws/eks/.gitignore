# Secrets
# (.env is also covered by the repo-root `deploy/**/.env` rule.)
.env

# Generated initial admin credentials (random password written by setup.sh
# AUTO_INIT when none is supplied). Must NOT be committed.
.admin-credentials

# Generated certificates
certs/

# MongoDB replica-set keyfile — should be generated per-deploy (openssl rand)
# and rotated per environment, like jwt-keys.sh does for the registry keypair.
# Must NOT be committed.
# Not tracked in git — setup.sh generates it per-deploy via
# deploy/bin/mongo-keyfile.sh (pb_ensure_mongo_keyfile) before
# pb_create_config_maps reads it. A fresh checkout ships none.
mongodb-keyfile
