        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, lane) (rate(ecosystem_decision_latency_seconds_bucket[6h])))",
