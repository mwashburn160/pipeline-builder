# CDK Synth Plugin — build environment for AWS CDK pipeline synthesis.
# Used as the synth step (CodeBuildStep) of a pipeline-core Builder pipeline;
# runs `pipeline-manager synth` → `cdk synth`.
#
# Built FROM the CodeBuild bootstrap image so it INHERITS the exact, version-
# locked synth toolchain — Node, AWS CLI v2, the AWS CDK CLI, esbuild, pnpm and
# pipeline-manager — and can never drift behind it. That drift is what broke
# this stage: the old image (FROM plugin-aws-cli-base) re-installed cdk +
# pipeline-manager but omitted esbuild/pnpm, so `cdk synth` fell back to DOCKER
# bundling of the PluginLookup Lambda — which has no daemon inside CodeBuild and
# fails (`/var/run/docker.sock: no such file`). With esbuild inherited here, the
# Lambda bundles locally; no Docker needed.
#
# One release, two halves: this plugin and pipeline-bootstrap share a version
# (both plugin-spec.yaml files), and this image is FROM exactly that release's
# bootstrap. build-plugin-images.sh builds the bootstrap in its base stage, then
# builds this with BOOTSTRAP_IMAGE=<registry>/library/pipeline-bootstrap@<digest>
# — pinned by DIGEST, in the same run. The default below is only for a build
# outside that script (e.g. the plugin service building from source, where the
# bare name resolves through the registry mirror to library/); it names the
# same release by its immutable version tag and is GENERATED by
# deploy/bin/sync-image-tags.sh — never edit it by hand.
ARG BOOTSTRAP_IMAGE="pipeline-bootstrap:1.1.1"
FROM ${BOOTSTRAP_IMAGE}

# The bootstrap image (node:26-slim) runs as root, so the build steps below
# need no switch; the image still ends on uid 1000 (node:*-slim's stock `node`
# user) like every other plugin. Global npm installs land under /usr/local —
# root-owned but world-readable/executable.
USER root

# Extra runtimes for synthesizing CDK apps authored in Python or TypeScript
# (the pipeline-builder boilerplate itself is compiled JS and needs neither, but
# this plugin is a general CDK-synth environment). node:26-slim has no apt-retry
# helper, so install directly. Docker CLI is intentionally NOT installed: docker
# bundling can't work in CodeBuild (no daemon) and esbuild handles it locally.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g typescript@6.0.3 ts-node@10.9.2

WORKDIR /app
USER 1000:1000
CMD ["bash"]
