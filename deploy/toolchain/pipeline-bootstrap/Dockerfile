# Pipeline Builder — pipeline-bootstrap (the managed toolchain's build image)
#
# Built tag: pipeline-bootstrap:<release version> — the `version` in this
# directory's plugin-spec.yaml, shared with cdk-synth (one release, two halves).
# build-plugin-images.sh builds it in its base stage, after the `_base` images
# and before any plugin, pushes `library/pipeline-bootstrap:<version>` (the base
# cdk-synth builds FROM, by digest) and saves image.tar for load-plugins.sh.
# A version is immutable: the base stage refuses to re-push one that is already
# published with different bits. Any change to this file is a new release —
# deploy/bin/sync-image-tags.sh bumps the patch of both specs when the
# sourceDigest of the two directories changes.
#
# This is the CodeBuild runtime for steps that have no plugin-baked image:
#   - cold-start synth (pipeline-core's `bootstrap()` path)
#   - ShellSteps that don't have a registry image
#   - `metadata_only` plugins
#
# Without it, those steps would run on AWS-managed `aws/codebuild/standard:7.0`,
# which DOES NOT have `pipeline-manager` on PATH — the first CodeBuild action in
# a cold-start pipeline would exit 127 ("not found") on the synth command.
# `bootstrap()` in pipeline-core deliberately does NOT include a self-heal
# `npm install -g` step (that masked configuration problems and added ~30s to
# every cold start); the contract is that the build image carries
# `pipeline-manager` on PATH, which is exactly what this image provides.
#
# Why a slim base instead of the AWS CodeBuild standard image:
#
# Cold-start synth only needs Node + AWS CLI + git + the AWS CDK CLI on PATH
# (`pipeline-manager pipeline synth` shells out to `cdk synth`). The full
# `aws/codebuild/standard:7.0` (and its public-ECR Amazon Linux variants)
# bundles every language runtime AWS CodeBuild supports — Node, Python,
# Ruby, Go, multiple JDKs, .NET, PHP, etc. — and weighs ~18 GB. Pushing
# that through the in-cluster registry on every refresh, and pulling it
# in CodeBuild on every cold-start, was wildly wasteful for what the
# bootstrap path actually executes (`pipeline-manager pipeline synth`).
#
# This image is ~400 MB instead. If a plugin needs a runtime we don't
# bake here, that plugin brings its own image (cdk-synth is FROM this image
# and adds Python + TypeScript; per-language plugins have their own runtime).
#
# It lives with cdk-synth in deploy/toolchain/, the managed toolchain's own
# source root — the pair is one release, not catalog plugins — and it does not
# consume `plugin-base:26.10`. Its plugin-spec.yaml is `pluginType: BuildImage`;
# `version`, `toolchain` and `sourceDigest` there are GENERATED by
# sync-image-tags.sh from the ARGs below — never edit them by hand.

# Base pinned BY DIGEST (matches projen minNodeVersion 26.13.0): a re-pushed
# tag cannot change what CodeBuild runs. Renovate bumps the digest; that changes
# the sourceDigest, so it ships as a new release (never an in-place rebuild).
ARG NODE_IMAGE=node:26.13.0-slim@sha256:e4db4c914bf8ad241bd24804fc25d272d89bad97e68cdc8a1414862790a02c39
FROM ${NODE_IMAGE}

# ── Debian security updates ──
# A digest pin is the point of this base — a re-pushed tag cannot change what
# CodeBuild runs — but the same property freezes it against Debian's security
# archive. Ubuntu-derived plugin images get those fixes for free because upstream
# rebuilds ubuntu:26.10 continuously; a digest never moves at all, so this image
# drifts further behind for as long as the pin stands.
#
# That is what fails cdk-synth, which is FROM pipeline-bootstrap: its Critical
# findings are Debian's perl and tar, not anything this Dockerfile installs.
#
# A whole-image upgrade rather than a package list, for the same reason as
# _ruby-base: naming packages only ever fixes the CVEs someone already saw, and
# the next advisory fails the gate again. The digest still pins what is
# reproducible about the build; this layer moves only within that Debian
# release.
RUN set -eux; \
    apt-get update; \
    apt-get upgrade -y; \
    rm -rf /var/lib/apt/lists/*

# Add: git (source ops), curl + unzip (AWS CLI install), AWS CLI v2,
# pipeline-manager. node:26-slim already has Node + npm + ca-certs.
# Matches the runtime baseline in projen (minNodeVersion: 26.13.0).
# PINNED to the released pipeline-manager version (was "latest"). The release
# keeps it current: verify_release runs deploy/bin/sync-image-tags.sh, which
# rewrites this line to packages/pipeline-manager/package.json's version and
# commits it with the other synced deploy pins. A concrete version also makes
# the npm-install layer cache-correct. Never overridden with --build-arg: the
# image's toolchain LABELs and the spec's `toolchain` must name the same bits.
ARG PIPELINE_MANAGER_VERSION="4.5.0"
# AWS CDK CLI — `pipeline-manager pipeline synth` shells out to `cdk synth`, so the
# `cdk` binary must be on PATH. Compatible with aws-cdk-lib 2.258.x.
#
# HELD EQUAL to the two plugins that install the CLI themselves — cdk-deploy and
# cdk-deploy-multi-region — by toolchain-drift-contract. It is not "pinned to
# match cdk-synth": that plugin installs no CDK at all, it is FROM this image
# and inherits the binary. The old comment also cited a version note in
# deploy/plugins/README.md that does not exist. Both claims were wrong, and in
# the meantime the pins DID drift: this sat at 2.1126.0 while the two plugins
# moved to 2.1147.0, which is how a bundled `tar` old enough to fail the vuln
# gate survived here.
#
# The CLI BUNDLES its dependencies (the published package declares none), so a
# finding inside it — `tar` in this case — cannot be overridden with another
# `npm install`. Bumping this pin is the only lever.
ARG AWS_CDK_VERSION="2.1148.0"
# esbuild — synth bundles the PluginLookup Lambda via `aws-lambda-nodejs`
# (NodejsFunction). When esbuild isn't detected it falls back to DOCKER
# bundling, which a slim no-docker CodeBuild image can't do (`spawnSync docker
# ENOENT`). With esbuild on PATH, aws-cdk-lib bundles the Lambda locally — no
# docker. Any 0.x satisfies aws-cdk-lib's major-version guard.
ARG ESBUILD_VERSION="0.28.1"
# pnpm — the PluginLookup Lambda ships a `pnpm-lock.yaml`, so aws-cdk-lib picks
# the pnpm package manager for bundling and runs esbuild as `pnpm exec -- esbuild`
# (esbuild resolves as a global module, so it's treated as a workspace package).
# No `pnpm install` runs during bundling (the Lambda sets no `nodeModules`), so
# pnpm is only the bin-runner — but it must be on PATH or bundling dies with
# `spawnSync pnpm ENOENT`. Pinned to the repo's packageManager (.projenrc.ts
# pnpmVersion); test/deploy-contracts (toolchain-drift-contract) holds them equal.
ARG PNPM_VERSION="12.14.0"
# cdk-assets — publishes a synthesized assembly's file and container assets
# (what `cdk-assets publish` does in a pipeline's Assets stage). Installed the
# same way as the CDK CLI and pinned the same way; a bump is a new release.
ARG CDK_ASSETS_VERSION="4.8.0"

# What this image carries, readable from the image itself. Each value is the ARG
# it is installed from, so a label cannot disagree with the binary; plugin
# upload refuses a spec whose `toolchain` disagrees with these labels, and
# hardening-contract holds every label to its ARG. `node` is the base image's
# own NODE_VERSION (the official node images set it), i.e. the Node that runs.
LABEL org.pipeline-builder.toolchain.pipeline-manager="${PIPELINE_MANAGER_VERSION}" \
      org.pipeline-builder.toolchain.aws-cdk="${AWS_CDK_VERSION}" \
      org.pipeline-builder.toolchain.cdk-assets="${CDK_ASSETS_VERSION}" \
      org.pipeline-builder.toolchain.esbuild="${ESBUILD_VERSION}" \
      org.pipeline-builder.toolchain.pnpm="${PNPM_VERSION}" \
      org.pipeline-builder.toolchain.node="${NODE_VERSION}"

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      git curl unzip ca-certificates; \
    rm -rf /var/lib/apt/lists/*; \
    # AWS CLI v2 — official installer, multi-arch aware.
    ARCH=$(uname -m); \
    case "$ARCH" in \
      x86_64)  AWSCLI_ARCH=x86_64 ;; \
      aarch64) AWSCLI_ARCH=aarch64 ;; \
      *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${AWSCLI_ARCH}.zip" -o /tmp/awscli.zip; \
    unzip -q /tmp/awscli.zip -d /tmp; \
    /tmp/aws/install; \
    rm -rf /tmp/aws /tmp/awscli.zip; \
    aws --version; \
    # pipeline-manager — the pinned PIPELINE_MANAGER_VERSION above.
    npm config set @pipeline-builder:registry=https://registry.npmjs.org/; \
    npm install -g "aws-cdk@${AWS_CDK_VERSION}" "cdk-assets@${CDK_ASSETS_VERSION}" "esbuild@${ESBUILD_VERSION}" "pnpm@${PNPM_VERSION}" "@pipeline-builder/pipeline-manager@${PIPELINE_MANAGER_VERSION}"; \
    cdk --version; \
    command -v cdk-assets; \
    esbuild --version; \
    pnpm --version; \
    pipeline-manager --version 2>&1 | tail -1

WORKDIR /app
CMD ["bash"]
