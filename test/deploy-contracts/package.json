{
  "name": "deploy-contracts",
  "scripts": {
    "build": "pnpm dlx projen build",
    "compile": "pnpm dlx projen compile",
    "default": "pnpm dlx projen default",
    "eslint": "pnpm dlx projen eslint",
    "lint:fix": "pnpm dlx projen lint:fix",
    "package": "pnpm dlx projen package",
    "post-compile": "pnpm dlx projen post-compile",
    "pre-compile": "pnpm dlx projen pre-compile",
    "test": "pnpm dlx projen test",
    "test:update": "pnpm dlx projen test:update",
    "test:watch": "pnpm dlx projen test:watch",
    "typecheck:tests": "pnpm dlx projen typecheck:tests",
    "watch": "pnpm dlx projen watch",
    "projen": "pnpm dlx projen"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@stylistic/eslint-plugin": "^2",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "jest": "30.5.2",
    "jest-junit": "^17",
    "ts-jest": "29.4.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">= 24.14.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=10",
      "onFail": "ignore"
    }
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.11",
  "packageManager": "pnpm@10.33.0",
  "jest": {
    "coverageProvider": "v8",
    "testMatch": [
      "<rootDir>/@(src|test)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(src|test)/**/__tests__/**/*.ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "test/tsconfig.json",
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "extensionsToTreatAsEsm": [
      ".ts",
      ".tsx"
    ],
    "moduleNameMapper": {
      "^uuid$": "<rootDir>/../../jest-uuid-stub.js",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "restoreMocks": true,
    "setupFilesAfterEnv": [
      "<rootDir>/../../jest-env-guard.js"
    ]
  },
  "type": "module",
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "default",
          "^default",
          "sharedGlobals",
          "{workspaceRoot}/deploy/**/*",
          "{workspaceRoot}/.github/workflows/*",
          "{workspaceRoot}/scripts/*",
          "{workspaceRoot}/README.md",
          "{workspaceRoot}/index.md",
          "!{projectRoot}/lib/**/*",
          "!{projectRoot}/dist/**/*"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^default",
          "sharedGlobals",
          "{workspaceRoot}/deploy/**/*",
          "{workspaceRoot}/.github/workflows/*",
          "{workspaceRoot}/scripts/*",
          "{workspaceRoot}/README.md",
          "{workspaceRoot}/index.md",
          "!{projectRoot}/lib/**/*",
          "!{projectRoot}/dist/**/*"
        ]
      }
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"pnpm dlx projen\"."
}
