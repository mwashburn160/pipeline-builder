{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(pnpm -c exec \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "execArgs": [
            "next",
            "build"
          ]
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "pnpm dlx projen default",
          "cwd": ".."
        }
      ]
    },
    "dev": {
      "name": "dev",
      "description": "Starts the Next.js application in development mode",
      "steps": [
        {
          "execArgs": [
            "next",
            "dev"
          ]
        }
      ]
    },
    "export": {
      "name": "export",
      "description": "Exports the application for production deployment",
      "steps": [
        {
          "execArgs": [
            "next",
            "export"
          ]
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "pnpm i --no-frozen-lockfile"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "pnpm i --frozen-lockfile"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "execArgs": [
            "mkdir",
            "-p",
            "dist/js"
          ]
        },
        {
          "execArgs": [
            "pnpm",
            "pack",
            "--pack-destination",
            "dist/js"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation",
      "steps": [
        {
          "exec": "node scripts/generate-plugin-icons.mjs"
        }
      ]
    },
    "server": {
      "name": "server",
      "description": "Starts the Next.js application in production mode",
      "steps": [
        {
          "execArgs": [
            "next",
            "start"
          ]
        }
      ]
    },
    "telemetry": {
      "name": "telemetry",
      "description": "Checks the status of Next.js telemetry collection",
      "steps": [
        {
          "execArgs": [
            "next",
            "telemetry"
          ]
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "spawn": "typecheck:tests"
        },
        {
          "execArgs": [
            "jest",
            "--passWithNoTests",
            "--updateSnapshot"
          ],
          "receiveArgs": true
        }
      ]
    },
    "test:watch": {
      "name": "test:watch",
      "description": "Run jest in watch mode",
      "steps": [
        {
          "execArgs": [
            "jest",
            "--watch"
          ]
        }
      ]
    },
    "typecheck:tests": {
      "name": "typecheck:tests",
      "description": "Type-check the frontend test suites (ts-jest only transpiles)",
      "steps": [
        {
          "exec": "tsc -p tsconfig.test.json --noEmit"
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"pnpm dlx projen\"."
}
