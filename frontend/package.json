{
  "name": "frontend",
  "scripts": {
    "build": "pnpm dlx projen build",
    "compile": "pnpm dlx projen compile",
    "default": "pnpm dlx projen default",
    "dev": "pnpm dlx projen dev",
    "eslint": "pnpm dlx projen eslint",
    "export": "pnpm dlx projen export",
    "lint:fix": "pnpm dlx projen lint:fix",
    "package": "pnpm dlx projen package",
    "post-compile": "pnpm dlx projen post-compile",
    "pre-compile": "pnpm dlx projen pre-compile",
    "server": "pnpm dlx projen server",
    "telemetry": "pnpm dlx projen telemetry",
    "test": "pnpm dlx projen test",
    "test:update": "pnpm dlx projen test:update",
    "test:watch": "pnpm dlx projen test:watch",
    "typecheck:tests": "pnpm dlx projen typecheck:tests",
    "projen": "pnpm dlx projen",
    "generate:help": "node scripts/generate-help.mjs",
    "generate:plugin-icons": "node scripts/generate-plugin-icons.mjs",
    "start": "next start",
    "docker:build": "PB_EXPECTED_PNPM=$(jq -r .packageManager package.json | sed \"s/^pnpm@//\"); PB_ACTUAL_PNPM=$(pnpm --version); [ \"$PB_EXPECTED_PNPM\" = \"$PB_ACTUAL_PNPM\" ] || { echo \"ERROR: pnpm $PB_ACTUAL_PNPM is active but package.json pins pnpm@$PB_EXPECTED_PNPM. Run: corepack prepare pnpm@$PB_EXPECTED_PNPM --activate\" >&2; exit 1; }; pnpm nx run-many -t build --projects=frontend --with-deps; rm -rf .docker-build; pnpm deploy --filter frontend --prod --legacy .docker-build; for d in .docker-build/node_modules/@pipeline-builder/*; do test -e \"$d/package.json\" || { echo \"ERROR: staged bundle dep $d is a dangling workspace symlink (wrong pnpm version staged the bundle). See the docker:build pnpm guard.\" >&2; exit 1; }; done; docker buildx build --pull --provenance=false --build-arg WORKSPACE=${WORKSPACE:-./} --secret id=npmrc,src=$(npm get userconfig) --load -t ${PROJECT_NAME:-frontend}:$(jq -r .version package.json) .; status=$?; rm -rf .docker-build; exit $status",
    "docker:tag": "docker image tag ${PROJECT_NAME:-frontend}:$(jq -r .version package.json) ${REGISTRY:-ghcr.io/mwashburn160}/${PROJECT_NAME:-frontend}:$(jq -r .version package.json)",
    "docker:push": "docker push ${REGISTRY:-ghcr.io/mwashburn160}/${PROJECT_NAME:-frontend}:$(jq -r .version package.json)",
    "docker:publish": "PB_EXPECTED_PNPM=$(jq -r .packageManager package.json | sed \"s/^pnpm@//\"); PB_ACTUAL_PNPM=$(pnpm --version); [ \"$PB_EXPECTED_PNPM\" = \"$PB_ACTUAL_PNPM\" ] || { echo \"ERROR: pnpm $PB_ACTUAL_PNPM is active but package.json pins pnpm@$PB_EXPECTED_PNPM. Run: corepack prepare pnpm@$PB_EXPECTED_PNPM --activate\" >&2; exit 1; }; pnpm nx run-many -t build --projects=frontend --with-deps; rm -rf .docker-build; pnpm deploy --filter frontend --prod --legacy .docker-build; for d in .docker-build/node_modules/@pipeline-builder/*; do test -e \"$d/package.json\" || { echo \"ERROR: staged bundle dep $d is a dangling workspace symlink (wrong pnpm version staged the bundle). See the docker:build pnpm guard.\" >&2; exit 1; }; done; docker buildx build --pull --provenance=false --build-arg WORKSPACE=${WORKSPACE:-./} --secret id=npmrc,src=$(npm get userconfig) --annotation \"index:org.opencontainers.image.description=Pipeline Builder web UI.\" ${DOCKER_CACHE:+--cache-from type=gha,scope=${PROJECT_NAME:-frontend} --cache-to type=gha,mode=max,scope=${PROJECT_NAME:-frontend}} --platform ${DOCKER_PLATFORMS:-linux/amd64,linux/arm64} -t ${REGISTRY:-ghcr.io/mwashburn160}/${PROJECT_NAME:-frontend}:$(jq -r .version package.json) --push .; status=$?; rm -rf .docker-build; exit $status",
    "docker:verify": "docker buildx imagetools inspect ${REGISTRY:-ghcr.io/mwashburn160}/${PROJECT_NAME:-frontend}:$(jq -r .version package.json) --raw | jq -e '[(.manifests // [])[].platform.architecture] as $a | (($a | index(\"amd64\")) and ($a | index(\"arm64\")))'"
  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "@stylistic/eslint-plugin": "^2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "10.5.4",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-junit": "^17",
    "postcss": "8.5.25",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "@pipeline-builder/api-core": "workspace:*",
    "@pipeline-builder/pipeline-core": "workspace:*",
    "@simplewebauthn/browser": "14.0.0",
    "framer-motion": "12.43.0",
    "lucide-react": "1.28.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-grid-layout": "2.2.4",
    "react-resizable": "4.0.2",
    "tailwindcss": "4.3.3",
    "uqr": "0.1.3"
  },
  "engines": {
    "node": ">= 24.14.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=10",
      "onFail": "ignore"
    }
  },
  "main": "lib/index.js",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "jest": {
    "coverageProvider": "v8",
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts",
      "<rootDir>/test/**/*.test.tsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/jest.setup.ts",
      "<rootDir>/../jest-env-guard.js"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.next/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json",
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^uuid$": "<rootDir>/../jest-uuid-stub.js",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@pipeline-builder/api-core/permissions$": "<rootDir>/../packages/api-core/src/types/permissions.ts",
      "^@pipeline-builder/api-core/metadata-keys$": "<rootDir>/../packages/api-core/src/types/metadata-keys.ts",
      "^@pipeline-builder/api-core/feature-flags$": "<rootDir>/../packages/api-core/src/types/feature-flags.ts",
      "^@pipeline-builder/api-core/plugin-catalog$": "<rootDir>/../packages/api-core/src/types/plugin-catalog.ts",
      "^@pipeline-builder/pipeline-core/template$": "<rootDir>/../packages/pipeline-core/src/template/tokenizer.ts"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/.next/"
    ],
    "restoreMocks": true,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/testing/**",
      "!src/components/build-queue/types.ts",
      "!src/components/reports/types.ts",
      "!src/components/users/types.ts",
      "!src/lib/feature-flags.ts",
      "!src/lib/help/types.ts",
      "!src/types/audit.ts",
      "!src/types/compliance-notifications.ts",
      "!src/types/compliance.ts",
      "!src/types/ecosystem.ts",
      "!src/types/observability.ts",
      "!src/types/plugin-installs.ts",
      "!src/types/plugin-reviews.ts",
      "!src/types/plugin-submissions.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 84,
        "branches": 78,
        "functions": 63,
        "lines": 84
      }
    }
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "default",
          "^default",
          "sharedGlobals",
          "{workspaceRoot}/docs/**/*",
          "{workspaceRoot}/deploy/plugins/_icons/*",
          "!{projectRoot}/lib/**/*",
          "!{projectRoot}/dist/**/*"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^default",
          "sharedGlobals",
          "{workspaceRoot}/docs/**/*",
          "{workspaceRoot}/deploy/plugins/_icons/*",
          "!{projectRoot}/lib/**/*",
          "!{projectRoot}/dist/**/*"
        ]
      }
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"pnpm dlx projen\"."
}
